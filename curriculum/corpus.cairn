fn affine_0(x:u64) -> u64 {
  return add_wrap(mul_wrap(x, 2), 1);
}

fn affine_1(x:u64) -> u64 {
  return add_wrap(mul_wrap(x, 3), 4);
}

fn affine_2(x:u64) -> u64 {
  return add_wrap(mul_wrap(x, 4), 7);
}

fn affine_3(x:u64) -> u64 {
  return add_wrap(mul_wrap(x, 5), 10);
}

fn affine_4(x:u64) -> u64 {
  return add_wrap(mul_wrap(x, 6), 13);
}

fn affine_5(x:u64) -> u64 {
  return add_wrap(mul_wrap(x, 7), 16);
}

fn affine_6(x:u64) -> u64 {
  return add_wrap(mul_wrap(x, 8), 19);
}

fn affine_7(x:u64) -> u64 {
  return add_wrap(mul_wrap(x, 9), 22);
}

fn count_gt_0(n:usize, x:ro<u64>[n]@host, threshold:u64) -> usize {
  let mut total:usize = 0;
  for i in 0..n {
    if (x[i] > threshold) {
      total = add_wrap(total, 1);
    }
  }
  return total;
}

