{
 "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
 "name": "CAIRN",
 "scopeName": "source.cairn",
 "comment": "Generated by `python -m cairn.editor.grammar` from the compiler's vocabulary; do not edit.",
 "patterns": [
  {
   "include": "#comments"
  },
  {
   "include": "#strings"
  },
  {
   "include": "#unsafe"
  },
  {
   "include": "#placements"
  },
  {
   "include": "#effects"
  },
  {
   "include": "#declarations"
  },
  {
   "include": "#bindings"
  },
  {
   "include": "#borrows"
  },
  {
   "include": "#context"
  },
  {
   "include": "#keywords"
  },
  {
   "include": "#numbers"
  },
  {
   "include": "#variants"
  },
  {
   "include": "#types"
  },
  {
   "include": "#calls"
  },
  {
   "include": "#operators"
  }
 ],
 "repository": {
  "comments": {
   "patterns": [
    {
     "name": "comment.line.double-slash.cairn",
     "begin": "//",
     "end": "$",
     "patterns": [
      {
       "name": "constant.other.diagnostic-code.cairn",
       "match": "\\bE-[A-Z0-9]+(?:-[A-Z0-9]+)*\\b"
      }
     ]
    }
   ]
  },
  "strings": {
   "patterns": [
    {
     "name": "string.quoted.double.cairn",
     "begin": "\"",
     "end": "\"",
     "patterns": [
      {
       "name": "constant.character.escape.cairn",
       "match": "\\\\(?:x[0-9A-Fa-f]{2}|[ntr0\\\\\\\"'])"
      },
      {
       "name": "invalid.illegal.escape.cairn",
       "match": "\\\\."
      }
     ]
    },
    {
     "name": "string.quoted.single.cairn",
     "begin": "'",
     "end": "'",
     "patterns": [
      {
       "name": "constant.character.escape.cairn",
       "match": "\\\\(?:x[0-9A-Fa-f]{2}|[ntr0\\\\\\\"'])"
      },
      {
       "name": "invalid.illegal.escape.cairn",
       "match": "\\\\."
      }
     ]
    }
   ]
  },
  "unsafe": {
   "patterns": [
    {
     "name": "meta.block.unsafe.cairn",
     "begin": "\\b(unsafe)\\s*(\\{)",
     "beginCaptures": {
      "1": {
       "name": "keyword.other.unsafe.cairn"
      },
      "2": {
       "name": "punctuation.section.block.begin.cairn"
      }
     },
     "end": "\\}",
     "endCaptures": {
      "0": {
       "name": "punctuation.section.block.end.cairn"
      }
     },
     "patterns": [
      {
       "include": "#braces"
      },
      {
       "include": "$self"
      }
     ]
    }
   ]
  },
  "braces": {
   "patterns": [
    {
     "begin": "\\{",
     "end": "\\}",
     "patterns": [
      {
       "include": "#braces"
      },
      {
       "include": "$self"
      }
     ]
    }
   ]
  },
  "placements": {
   "patterns": [
    {
     "match": "(@)(unified|device|pinned|host)\\b",
     "captures": {
      "1": {
       "name": "punctuation.definition.placement.cairn"
      },
      "2": {
       "name": "storage.modifier.placement.cairn"
      }
     }
    }
   ]
  },
  "effects": {
   "patterns": [
    {
     "begin": "\\b(effects)\\s*(\\()",
     "beginCaptures": {
      "1": {
       "name": "storage.modifier.cairn"
      },
      "2": {
       "name": "punctuation.section.parens.begin.cairn"
      }
     },
     "end": "\\)",
     "endCaptures": {
      "0": {
       "name": "punctuation.section.parens.end.cairn"
      }
     },
     "patterns": [
      {
       "match": "\\b(transfer|write|lane|read|asm|ffi|par)(:)([A-Za-z_]\\w*)",
       "captures": {
        "1": {
         "name": "support.constant.effect.cairn"
        },
        "2": {
         "name": "punctuation.separator.effect.cairn"
        },
        "3": {
         "name": "variable.other.effect.cairn"
        }
       }
      },
      {
       "name": "support.constant.effect.cairn",
       "match": "\\b(?:ffi_precondition|indirect_call|stack_storage|local_write|local_read|gpu_alloc|zero_init|dispatch|gpu_free|barrier|diverge|atomic|alloc|fence|spawn|free|join|lock|mmio|trap|asm|io)\\b"
      },
      {
       "name": "punctuation.separator.comma.cairn",
       "match": ","
      }
     ]
    }
   ]
  },
  "declarations": {
   "patterns": [
    {
     "match": "\\b(fn|kernel)\\s+([A-Za-z_]\\w*)",
     "captures": {
      "1": {
       "name": "keyword.declaration.function.cairn"
      },
      "2": {
       "name": "entity.name.function.cairn"
      }
     }
    },
    {
     "match": "\\b(struct|enum|trait)\\s+([A-Za-z_]\\w*)",
     "captures": {
      "1": {
       "name": "keyword.declaration.type.cairn"
      },
      "2": {
       "name": "entity.name.type.cairn"
      }
     }
    },
    {
     "match": "\\b(module|import)\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
     "captures": {
      "1": {
       "name": "keyword.declaration.module.cairn"
      },
      "2": {
       "name": "entity.name.namespace.cairn"
      }
     }
    },
    {
     "match": "\\b(as)\\s+([A-Za-z_]\\w*)(?=\\s*;)",
     "captures": {
      "1": {
       "name": "storage.modifier.cairn"
      },
      "2": {
       "name": "entity.name.namespace.cairn"
      }
     }
    },
    {
     "match": "\\b(const)\\s+([A-Za-z_]\\w*)",
     "captures": {
      "1": {
       "name": "keyword.declaration.constant.cairn"
      },
      "2": {
       "name": "variable.other.constant.cairn"
      }
     }
    },
    {
     "match": "\\b(family)\\s+([A-Za-z_]\\w*)",
     "captures": {
      "1": {
       "name": "keyword.declaration.function.cairn"
      },
      "2": {
       "name": "entity.name.function.cairn"
      }
     }
    },
    {
     "match": "\\b(recipe)\\s+([A-Za-z_]\\w*)",
     "captures": {
      "1": {
       "name": "keyword.declaration.cairn"
      },
      "2": {
       "name": "entity.name.function.recipe.cairn"
      }
     }
    },
    {
     "match": "\\b(plan)\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)(?=\\s*(?:\\{|use\\b))",
     "captures": {
      "1": {
       "name": "keyword.declaration.cairn"
      },
      "2": {
       "name": "entity.name.function.cairn"
      }
     }
    },
    {
     "match": "\\b(test)\\s+([A-Za-z_]\\w*)(?=\\s*\\{)",
     "captures": {
      "1": {
       "name": "keyword.declaration.cairn"
      },
      "2": {
       "name": "entity.name.function.cairn"
      }
     }
    },
    {
     "match": "\\b(layout)\\s+([A-Za-z_]\\w*)(?=\\s*=)",
     "captures": {
      "1": {
       "name": "keyword.declaration.cairn"
      },
      "2": {
       "name": "variable.other.constant.cairn"
      }
     }
    },
    {
     "match": "\\b(derive)\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
     "captures": {
      "1": {
       "name": "keyword.declaration.cairn"
      },
      "2": {
       "name": "entity.name.function.recipe.cairn"
      }
     }
    },
    {
     "match": "\\b(let|reg|buffer|stack)\\s+(?:(mut)\\s+)?([A-Za-z_]\\w*)",
     "captures": {
      "1": {
       "name": "storage.type.binding.cairn"
      },
      "2": {
       "name": "storage.modifier.cairn"
      },
      "3": {
       "name": "variable.other.declaration.cairn"
      }
     }
    },
    {
     "match": "\\b(for|each)\\s+([A-Za-z_]\\w*)(?=\\s+in\\b)",
     "captures": {
      "1": {
       "name": "keyword.control.loop.cairn"
      },
      "2": {
       "name": "variable.other.declaration.cairn"
      }
     }
    },
    {
     "match": "\\b(parallel)\\s+([A-Za-z_]\\w*)(?=\\s+in\\b)",
     "captures": {
      "1": {
       "name": "keyword.control.concurrency.cairn"
      },
      "2": {
       "name": "variable.other.declaration.cairn"
      }
     }
    }
   ]
  },
  "bindings": {
   "patterns": [
    {
     "match": "(?<=[\\[(,|])\\s*([A-Z]\\w*)\\s*(:)",
     "captures": {
      "1": {
       "name": "entity.name.type.parameter.cairn"
      },
      "2": {
       "name": "punctuation.separator.type.cairn"
      }
     }
    },
    {
     "match": "(?<=[(,|])\\s*([a-z_]\\w*)\\s*(:)",
     "captures": {
      "1": {
       "name": "variable.parameter.cairn"
      },
      "2": {
       "name": "punctuation.separator.type.cairn"
      }
     }
    },
    {
     "match": "(?<=[{;])\\s*([a-z_]\\w*)\\s*(:)",
     "captures": {
      "1": {
       "name": "variable.other.property.cairn"
      },
      "2": {
       "name": "punctuation.separator.type.cairn"
      }
     }
    },
    {
     "name": "support.type.bound.cairn",
     "match": "(?<=[:+])\\s*(?:unsigned|integer|numeric|affine|linear|scalar|signed|float|copy|type|nat)\\b"
    }
   ]
  },
  "borrows": {
   "patterns": [
    {
     "begin": "\\b(ro|rw)\\s*(<)",
     "beginCaptures": {
      "1": {
       "name": "storage.modifier.borrow.cairn"
      },
      "2": {
       "name": "punctuation.definition.typeparameters.begin.cairn"
      }
     },
     "end": ">",
     "endCaptures": {
      "0": {
       "name": "punctuation.definition.typeparameters.end.cairn"
      }
     },
     "patterns": [
      {
       "include": "$self"
      }
     ]
    }
   ]
  },
  "context": {
   "patterns": [
    {
     "name": "keyword.control.concurrency.cairn",
     "match": "\\bafter\\b(?=\\s+[A-Za-z_])"
    },
    {
     "name": "storage.modifier.layout.cairn",
     "match": "\\balign\\b(?=\\s*\\(\\s*[0-9]+\\s*\\)\\s*\\{)"
    },
    {
     "name": "keyword.other.plan.cairn",
     "match": "\\bblock\\b(?=\\s+[0-9])"
    },
    {
     "name": "storage.modifier.cairn",
     "match": "\\bclobbers\\b(?=\\s*\\(\\s*[a-z][a-z0-9]*\\s*[,)])"
    },
    {
     "name": "keyword.control.concurrency.cairn",
     "match": "\\bexclusive\\b(?=\\s+[A-Za-z_]\\w*\\s+(?:for|parallel)\\b)"
    },
    {
     "name": "keyword.control.flow.cairn",
     "match": "\\bfold\\b(?=\\s*(?:[-+*&|^]|[A-Za-z_][\\w.]*\\s+each\\b))"
    },
    {
     "name": "keyword.other.plan.cairn",
     "match": "\\bfuse\\b(?=\\s+[0-9])"
    },
    {
     "name": "keyword.other.plan.cairn",
     "match": "\\bgrain\\b(?=\\s+[0-9])"
    },
    {
     "name": "keyword.declaration.cairn",
     "match": "\\bimplements\\b(?=\\s+[A-Za-z_][\\w.]*\\s*(?:when\\b|needs\\b|\\{|=))"
    },
    {
     "name": "keyword.control.concurrency.cairn",
     "match": "\\binto\\b(?=\\s+[A-Za-z_]\\w*\\s*;)"
    },
    {
     "name": "keyword.other.plan.cairn",
     "match": "\\blanes\\b(?=\\s+[0-9])"
    },
    {
     "name": "keyword.declaration.cairn",
     "match": "\\blayout\\b(?=\\s+[A-Za-z_]\\w*\\s*=)"
    },
    {
     "name": "storage.modifier.cairn",
     "match": "\\blends\\b(?=\\s+[A-Za-z_]\\w*\\s*\\[)"
    },
    {
     "name": "storage.modifier.cairn",
     "match": "\\bneeds\\b(?=\\s*\\(\\s*sm_)"
    },
    {
     "name": "storage.modifier.cairn",
     "match": "\\bout\\b(?=\\s+[A-Za-z_]\\w*\\s*:)"
    },
    {
     "name": "storage.modifier.layout.cairn",
     "match": "\\bpacked\\b(?=\\s*\\{)"
    },
    {
     "name": "keyword.other.plan.cairn",
     "match": "\\bper_lane\\b(?=\\s+[0-9])"
    },
    {
     "name": "keyword.declaration.cairn",
     "match": "\\bplan\\b(?=\\s+[A-Za-z_][\\w.]*\\s*(?:\\{|use\\b))"
    },
    {
     "name": "keyword.declaration.cairn",
     "match": "\\brecipe\\b(?=\\s+[A-Za-z_]\\w*\\s*[\\[({]|\\s+[A-Za-z_]\\w*\\s+for\\b)"
    },
    {
     "name": "keyword.control.flow.cairn",
     "match": "\\brequire\\b(?=\\s+\\S[^;]*,\\s*\\\")"
    },
    {
     "name": "keyword.control.concurrency.cairn",
     "match": "\\bscan\\b(?=\\s+(?:[-+*&|^]|(?:min|max|add_wrap|mul_wrap)\\b)\\s*[A-Za-z_])"
    },
    {
     "name": "keyword.other.plan.cairn",
     "match": "\\bstage\\b(?=\\s+[0-9])"
    },
    {
     "name": "keyword.declaration.cairn",
     "match": "\\btest\\b(?=\\s+[A-Za-z_]\\w*\\s*\\{)"
    },
    {
     "name": "keyword.other.plan.cairn",
     "match": "\\bunroll\\b(?=\\s+[0-9])"
    },
    {
     "name": "keyword.other.plan.cairn",
     "match": "\\buse\\b(?=\\s+[A-Za-z_][\\w.]*\\s*;)"
    },
    {
     "name": "keyword.other.plan.cairn",
     "match": "\\bvector\\b(?=\\s+[0-9])"
    },
    {
     "name": "storage.modifier.cairn",
     "match": "\\bvolatile\\b(?=\\s+(?:ptx|x86_64|aarch64)\\b)"
    },
    {
     "name": "keyword.control.conditional.cairn",
     "match": "\\bwhen\\b(?=\\s+[A-Za-z_(!~0-9])"
    }
   ]
  },
  "keywords": {
   "patterns": [
    {
     "name": "keyword.control.conditional.cairn",
     "match": "\\b(?:match|else|if)\\b"
    },
    {
     "name": "keyword.control.loop.cairn",
     "match": "\\b(?:while|each|for|in)\\b"
    },
    {
     "name": "keyword.control.flow.cairn",
     "match": "\\b(?:continue|return|break|defer|yield|try)\\b"
    },
    {
     "name": "keyword.control.concurrency.cairn",
     "match": "\\b(?:parallel|compact|reduce|spawn)\\b"
    },
    {
     "name": "keyword.declaration.cairn",
     "match": "\\b(?:derive|extern|family|import|kernel|module|struct|const|trait|where|enum|impl|type|nat|fn)\\b"
    },
    {
     "name": "storage.type.binding.cairn",
     "match": "\\b(?:buffer|stack|let|reg)\\b"
    },
    {
     "name": "storage.modifier.cairn",
     "match": "\\b(?:effects|linear|unsafe|pure|dyn|mut|pub|as|ro|rw)\\b"
    },
    {
     "name": "constant.language.cairn",
     "match": "\\b(?:zeroed|false|true)\\b"
    }
   ]
  },
  "numbers": {
   "patterns": [
    {
     "name": "constant.numeric.integer.hexadecimal.cairn",
     "match": "\\b0x[0-9A-Fa-f]+\\b"
    },
    {
     "name": "constant.numeric.float.cairn",
     "match": "\\b[0-9]+(?:\\.[0-9]+)?[eE][+-]?[0-9]+\\b|\\b[0-9]+\\.[0-9]+\\b"
    },
    {
     "name": "constant.numeric.integer.decimal.cairn",
     "match": "\\b[0-9]+\\b"
    }
   ]
  },
  "variants": {
   "patterns": [
    {
     "match": "\\b([A-Z]\\w*)(\\.)([A-Z]\\w*)\\b",
     "captures": {
      "1": {
       "name": "entity.name.type.cairn"
      },
      "2": {
       "name": "punctuation.accessor.cairn"
      },
      "3": {
       "name": "variable.other.enummember.cairn"
      }
     }
    },
    {
     "name": "variable.other.enummember.cairn",
     "match": "(?<![.\\w$])(?:Overflow|Invalid|Empty|None|Some|Err|Ok)\\b"
    }
   ]
  },
  "types": {
   "patterns": [
    {
     "name": "variable.language.self.cairn",
     "match": "\\b(?:self|Self)\\b"
    },
    {
     "name": "support.type.cairn",
     "match": "\\b(?:TmemAcc|WmmaAcc|Atomic|IoRing|MmaAcc|Ticket|f8e4m3|f8e5m2|Array|Group|Mutex|WmmaA|WmmaB|usize|MmaA|MmaB|bf16|bool|void|Buf|Dyn|f16|f32|f64|i16|i32|i64|u16|u32|u64|i8|u8)\\b"
    },
    {
     "name": "variable.other.constant.cairn",
     "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![\\[(.])"
    },
    {
     "name": "entity.name.type.cairn",
     "match": "\\b[A-Z]\\w*\\b"
    }
   ]
  },
  "calls": {
   "patterns": [
    {
     "name": "support.function.builtin.cairn",
     "match": "\\b(?:quantize_stochastic|mma_unordered|mmio_write|assert_eq|from_bits|mmio_read|add_wrap|eprintln|mul_wrap|quantize|shl_wrap|sub_wrap|transfer|collect|println|to_bits|assert|eprint|format|floor|print|store|trunc|ceil|load|sqrt|swap|take|wait|abs|asm|len|max|min|shr)\\b(?=(?:\\[(?:[^\\[\\]]|\\[[^\\[\\]]*\\])*\\])?\\s*\\()"
    },
    {
     "name": "entity.name.function.member.cairn",
     "match": "(?<=\\.)[a-z_]\\w*(?=(?:\\[(?:[^\\[\\]]|\\[[^\\[\\]]*\\])*\\])?\\s*\\()"
    },
    {
     "name": "entity.name.function.call.cairn",
     "match": "\\b[a-z_]\\w*(?=(?:\\[(?:[^\\[\\]]|\\[[^\\[\\]]*\\])*\\])?\\s*\\()"
    },
    {
     "name": "variable.other.metavariable.cairn",
     "match": "\\$[A-Za-z_]\\w*"
    }
   ]
  },
  "operators": {
   "patterns": [
    {
     "name": "keyword.operator.comparison.cairn",
     "match": "==|!=|<=|>="
    },
    {
     "name": "keyword.operator.arrow.cairn",
     "match": "=>|->"
    },
    {
     "name": "keyword.operator.assignment.compound.cairn",
     "match": "[-+*/%&|^]="
    },
    {
     "name": "keyword.operator.logical.cairn",
     "match": "&&|\\|\\||!"
    },
    {
     "name": "keyword.operator.range.cairn",
     "match": "\\.\\."
    },
    {
     "name": "keyword.operator.assignment.cairn",
     "match": "="
    },
    {
     "name": "keyword.operator.comparison.cairn",
     "match": "[<>]"
    },
    {
     "name": "keyword.operator.arithmetic.cairn",
     "match": "[-+*/%]"
    },
    {
     "name": "keyword.operator.bitwise.cairn",
     "match": "[&|^~]"
    },
    {
     "name": "punctuation.terminator.statement.cairn",
     "match": ";"
    },
    {
     "name": "punctuation.separator.comma.cairn",
     "match": ","
    },
    {
     "name": "punctuation.accessor.cairn",
     "match": "\\."
    },
    {
     "name": "punctuation.separator.type.cairn",
     "match": ":"
    }
   ]
  }
 }
}
