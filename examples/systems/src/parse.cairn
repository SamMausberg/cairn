// Decimal parser with explicit, recoverable outcomes and first-failure offsets.
enum Parsed { Value(u64); Invalid(usize); Overflow(usize); Empty; }

fn decimal(n:usize, input:ro<u8>[n]) -> Parsed {
  if n == 0 { return Empty; }
  let mut value = 0;
  for i, byte in input {
    if byte < 48 || byte > 57 { return Invalid(i); }
    let digit = u64(byte - 48);
    if value > (18446744073709551615 - digit) / 10 {
      return Overflow(i);
    }
    value = value * 10 + digit;
  }
  return Value(value);
}

// An ordinary value record makes the foreign test interface explicit.
struct ParseObservation { kind:u32; value:u64; offset:usize; }
fn observe_decimal(n:usize, input:ro<u8>[n]) -> ParseObservation {
  match decimal(input) {
    Value(value) => return ParseObservation(0, value, 0);
    Invalid(offset) => return ParseObservation(1, 0, offset);
    Overflow(offset) => return ParseObservation(2, 0, offset);
    Empty => return ParseObservation(3, 0, 0);
  }
}

fn decimal_kind(n:usize, input:ro<u8>[n]) -> u32 {
  let result = observe_decimal(input);
  return result.kind;
}
