// Counts values into 256 bins with a parallel region: lane b owns row b of the partial counts.
import std.core (Option, Result);
import std.io as io;
import std.text as text;
import std.vec (Vec);

struct Input { bytes:Vec[u8]; at:usize; }
struct Span { lo:usize; hi:usize; }

// All of standard input.
fn read_input() -> Input {
  let mut bytes = vec.new[u8]();
  stack chunk:u8[4096] = zeroed;
  let mut more = true;
  while more {
    match io.read_stdin(4096, chunk) {
      Ok(got) => {
        if got == 0 { more = false; } else { vec.extend_from(bytes, got, chunk[0..got]); }
      }
      Err(_) => more = false;
    }
  }
  return Input(bytes, 0);
}

// The next run of bytes that are not spaces, tabs or line ends, or None at the end of the input.
fn next_token(inp:rw<Input>) -> Option[Span] {
  let n = inp.bytes.len;
  let mut lo = inp.at;
  while lo < n && inp.bytes.data[lo] <= 32 { lo += 1; }
  if lo >= n { return None; }
  let mut hi = lo;
  while hi < n && inp.bytes.data[hi] > 32 { hi += 1; }
  inp.at = hi;
  return Some(Span(lo, hi));
}

// The next token as an unsigned integer; the input is well formed, so anything else is a guard failure.
fn next_u64(inp:rw<Input>) -> u64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_u64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an unsigned integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

// Lane b counts the values of its own contiguous part into partial[b * 256 .. b * 256 + 256].
fn count(n:usize, values:ro<u32>[n], shift:usize, k:usize, rows:usize, partial:rw<u64>[rows]) {
  parallel b in k {
    let lo = b * n / k;
    let hi = (b + 1) * n / k;
    let row = b * 256;
    for i in lo..hi {
      let bin = usize(shr(values[i], shift) & 255);
      partial[row + bin] += 1;
    }
  }
}

fn main() -> i32 {
  let mut inp = read_input();
  let count_in = next_u64(inp);
  let shift_in = next_u64(inp);
  let n = usize(count_in);
  let mut values = Buf[u32](n);
  for i in 0..n {
    let v = next_u64(inp);
    values[i] = u32(v);
  }
  let k:usize = 8;
  let mut partial = Buf[u64](k * 256);
  count(values, usize(shift_in), k, partial);
  for v in 0..256 {
    let mut total:u64 = 0;
    for b in 0..k { total += partial[b * 256 + v]; }
    if total != 0 { println(v, " ", total); }
  }
  return 0;
}
