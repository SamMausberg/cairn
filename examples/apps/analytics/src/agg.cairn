// Pluggable aggregators and one generic container of my own. A query plan picks its
// aggregators at run time, so they are owned `Dyn[Aggregator]` values in a Vec; the hot loops
// take them by static bound instead, and the program checks that the two answer alike.
module analytics.agg;
import std.core (Ord);
import std.vec (Vec);

pub trait Aggregator {
  fn absorb(self:rw<Self>, value:u64);
  fn total(self:ro<Self>) -> u64;
}

// What separates one aggregator from the next is the function that folds a value into the
// accumulator, so that is what the recipe takes, spliced as this module wrote it.
pub fn counting(seen:u64, value:u64) -> u64 pure = add_wrap(seen, 1);

pub recipe folded[F:fn] for R {
  require count(R) == 1, "E-DERIVE-DOMAIN: folded/1 needs exactly one accumulator field.";
  each f in R {
    require unsigned(f), "E-DERIVE-DOMAIN: folded/1 accumulates an unsigned field.";
  }
  impl Aggregator for R {
    fn absorb(self:rw<R>, value:u64) { each f in R { self.$f = $F(self.$f, value); } }
    fn total(self:ro<R>) -> u64 { each f in R { return self.$f; } }
  }
}

pub struct SumAgg { acc:u64; }
pub struct MaxAgg { best:u64; }
pub struct CountAgg { seen:u64; }

derive folded[add_wrap] for SumAgg;
derive folded[max] for MaxAgg;
derive folded[counting] for CountAgg;

// Static dispatch: one instance of this loop per aggregator type, nothing indirect in it.
pub fn run_static[A:Aggregator](a:rw<A>, n:usize, xs:ro<u64>[n]) -> u64 {
  for i in 0..n { a.absorb(xs[i]); }
  return a.total();
}

// The same loop through a fat reference; `dispatch` is what it costs.
pub fn run_dyn(a:rw<dyn Aggregator>, n:usize, xs:ro<u64>[n]) -> u64 {
  for i in 0..n { a.absorb(xs[i]); }
  return a.total();
}

// A plan is a heterogeneous list of owned aggregators.
pub fn run_plan(plan:rw<Vec[Dyn[Aggregator]]>, n:usize, xs:ro<u64>[n], out:rw<u64>[4]) -> usize {
  let mut used:usize = 0;
  for p in 0..plan.len {
    if used < 4 {
      let answer = run_dyn(plan.data[p], xs);
      out[used] = answer;
      used = used + 1;
    }
  }
  return used;
}

// A generic container of mine: ordered bin edges and their counts. Zeroed storage holds the
// keys, which is what `affine` promises; nothing here copies one, so `copy` would ask for more
// than the bins need.
pub struct Bins[T:Ord + affine] { edges:Buf[T]; counts:Buf[u64]; }

pub fn bins_new[T:Ord + affine](k:usize) -> Bins[T] = Bins(Buf[T](k), Buf[u64](k + 1));

// The first bin whose edge is not below `value`; the last count is the overflow bin.
pub fn bins_slot[T:Ord + affine](b:ro<Bins[T]>, value:ro<T>) -> usize {
  let k = len(b.edges);
  for i in 0..k { if less(value, b.edges[i]) { return i; } }
  return k;
}

pub fn bins_tally[T:Ord + affine](b:rw<Bins[T]>, n:usize, xs:ro<T>[n]) {
  for i in 0..n {
    let slot = bins_slot(b, xs[i]);
    b.counts[slot] = add_wrap(b.counts[slot], 1);
  }
}

pub fn bins_total[T:Ord + affine](b:ro<Bins[T]>) -> u64 {
  let mut total = 0;
  for i in 0..len(b.counts) { total = add_wrap(total, b.counts[i]); }
  return total;
}
