// The device entry point. It fills the same columns the host entry ingests from a file (the
// dataset is a function of the row index, so the bytes are the same), answers three queries on
// both sides, and returns 0 only if the device agrees with the host bit for bit.
//
// This entry replaces src/main.cairn in gpu.toml: any @device view sends the whole program
// through nvcc, so the host-only configuration must not contain this module.
module analytics.gpumain;
import std.io;
import analytics.gpu;
import analytics.query;
import analytics.report;
import analytics.schema (Trade);
import analytics.table;

const ROWS:usize = 1000000;
const LIMIT:u64 = 8000000;

pub fn main() -> i32 {
  let rows:usize = ROWS;
  let mut c = schema.Trade_table_new(rows);
  for i in 0..rows { schema.Trade_set(c, i, table.synth(i)); }

  // Host answers first.
  let h0 = io.monotonic_ns();
  let host_total = query.wrapping_total(rows, c.price[0..rows]);
  let host_qty = query.checked_total(rows, c.qty[0..rows]);
  let mut host_kept = Buf[u64](rows);
  let host_used = query.above(rows, host_kept[0..rows], c.price[0..rows], LIMIT);
  let mut host_notional = Buf[u64](rows);
  query.notional_loop(rows, host_notional[0..rows], c.price[0..rows], c.qty[0..rows]);
  let h1 = io.monotonic_ns();

  // The same three queries over @device views.
  buffer d_price:u64[rows]@device = zeroed;
  buffer d_qty:u32[rows]@device = zeroed;
  buffer d_kept:u64[rows]@device = zeroed;
  let d0 = io.monotonic_ns(); // the first device allocation also creates the CUDA context
  transfer(d_price[0..rows], c.price[0..rows]);
  transfer(d_qty[0..rows], c.qty[0..rows]);
  let d1 = io.monotonic_ns();
  let dev_total = gpu.wrapping_total_device(rows, d_price);
  let dev_qty = gpu.checked_total_device(rows, d_qty);
  let dev_used = gpu.above_device(rows, d_kept, d_price, LIMIT);
  let d2 = io.monotonic_ns();
  if dev_total != host_total { return 1; }
  if dev_qty != host_qty { return 2; }
  if dev_used != host_used { return 3; }

  // The generated device reductions, one per column, against the generated host ones.
  let gen_price = gpu.Trade_device_wrapping_price(rows, d_price);
  let gen_qty = gpu.Trade_device_total_qty(rows, d_qty);
  if gen_price != schema.Trade_wrapping_price(rows, c) { return 7; }
  if gen_qty != schema.Trade_total_qty(rows, c) { return 8; }

  // The compacted prefix comes back and is compared element by element.
  let mut back_kept = Buf[u64](rows);
  transfer(back_kept[0..dev_used], d_kept[0..dev_used]);
  for i in 0..dev_used { if back_kept[i] != host_kept[i] { return 4; } }
  let d3 = io.monotonic_ns();

  // The queued pipeline, with pinned staging on the host side. Pinned memory is host memory,
  // but its placement is part of its type, so the columns are copied into it by hand.
  buffer p_price:u64[rows]@pinned = zeroed;
  buffer p_qty:u32[rows]@pinned = zeroed;
  buffer p_back:u64[rows]@pinned = zeroed;
  for i in 0..rows {
    p_price[i] = c.price[i];
    p_qty[i] = c.qty[i];
  }
  let q0 = io.monotonic_ns();
  let overlapped = gpu.queued_notional(
    rows, p_back, p_price, p_qty, c.price[0..rows], c.qty[0..rows]
  );
  let q1 = io.monotonic_ns();
  let mut queued_total:u64 = 0;
  for i in 0..rows {
    if p_back[i] != host_notional[i] { return 5; }
    queued_total = add_wrap(queued_total, p_back[i]);
  }
  if queued_total != overlapped { return 6; }

  report.line(29, "analytics: rows on the GPU   ", u64(rows));
  report.line(29, "analytics: rows above limit  ", u64(dev_used));
  report.line(29, "analytics: price total       ", dev_total);
  report.micros(29, "analytics: host queries      ", h1 - h0);
  report.micros(29, "analytics: upload            ", d1 - d0);
  report.micros(29, "analytics: device queries    ", d2 - d1);
  report.micros(29, "analytics: download          ", d3 - d2);
  report.micros(29, "analytics: queued pipeline   ", q1 - q0);
  let done = "analytics: the device agrees with the host bit for bit";
  report.say(len(done), done);
  return 0;
}
