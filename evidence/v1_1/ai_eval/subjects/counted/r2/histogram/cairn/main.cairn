// The input helpers below are given; everything else is yours to write.
import std.core (Option, Result);
import std.io as io;
import std.text as text;
import std.vec (Vec);

struct Input { bytes:Vec[u8]; at:usize; }
struct Span { lo:usize; hi:usize; }

// All of standard input.
fn read_input() -> Input {
  let mut bytes = vec.new[u8]();
  stack chunk:u8[4096] = zeroed;
  let mut more = true;
  while more {
    match io.read_stdin(4096, chunk) {
      Ok(got) => {
        if got == 0 { more = false; } else { vec.extend_from(bytes, got, chunk[0..got]); }
      }
      Err(_) => more = false;
    }
  }
  return Input(bytes, 0);
}

// The next run of bytes that are not spaces, tabs or line ends, or None at the end of the input.
fn next_token(inp:rw<Input>) -> Option[Span] {
  let n = inp.bytes.len;
  let mut lo = inp.at;
  while lo < n && inp.bytes.data[lo] <= 32 { lo += 1; }
  if lo >= n { return None; }
  let mut hi = lo;
  while hi < n && inp.bytes.data[hi] > 32 { hi += 1; }
  inp.at = hi;
  return Some(Span(lo, hi));
}

// The next token as an unsigned integer; the input is well formed, so anything else is a guard failure.
fn next_u64(inp:rw<Input>) -> u64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_u64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an unsigned integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

// The next token as a signed integer.
fn next_i64(inp:rw<Input>) -> i64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_i64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

const LANES:usize = 4;
const BINS:usize = 256;

// One lane's share of the values: its own row of BINS counters, so no lane touches another's memory.
fn count_range(cnt:usize, x:ro<u32>[cnt], shift:usize, out:rw<u64>[BINS]) {
  for i in 0..cnt {
    let v = x[i];
    let bin:usize = usize(shr(v, shift) & 255);
    out[bin] += 1;
  }
}

fn main() -> i32 {
  let mut inp = read_input();
  let raw_n = next_u64(inp);
  let n = usize(raw_n);
  let raw_shift = next_u64(inp);
  let shift = usize(raw_shift);

  let mut xs = Buf[u32](n);
  for i in 0..n {
    let raw_v = next_u64(inp);
    xs[i] = u32(raw_v);
  }

  let mut partial = Buf[u64](LANES * BINS);

  let a = n / 4;
  let b = 2 * n / 4;
  let c = 3 * n / 4;

  let p0:usize = 0;
  let p1 = BINS;
  let p2 = 2 * BINS;
  let p3 = 3 * BINS;
  let p4 = 4 * BINS;

  let t0 = spawn count_range(a, xs[0..a], shift, partial[p0..p1]);
  let t1 = spawn count_range(b - a, xs[a..b], shift, partial[p1..p2]);
  let t2 = spawn count_range(c - b, xs[b..c], shift, partial[p2..p3]);
  let t3 = spawn count_range(n - c, xs[c..n], shift, partial[p3..p4]);
  wait(t0);
  wait(t1);
  wait(t2);
  wait(t3);

  for v in 0..BINS {
    let mut total:u64 = 0;
    total += partial[0 * BINS + v];
    total += partial[1 * BINS + v];
    total += partial[2 * BINS + v];
    total += partial[3 * BINS + v];
    if total != 0 { println(v, ' ', total); }
  }
  return 0;
}
