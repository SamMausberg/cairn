// The vocabulary every other module shares, and the limits of each integer type. Importing a name is explicit:
// import std.core (Option, U64_MAX);
module std.core;

pub enum Option[T] { Some(T); None; }
pub enum Result[T, E] { Ok(T); Err(E); }

// Laws are documentation here, not proof obligations: less is a strict weak order, same an equivalence.
// Purity is an obligation: every implementation is held to it, so `[T:Ord]` promises a comparison that only reads.
pub trait Ord { fn less(a:ro<Self>, b:ro<Self>) -> bool pure; }
pub trait Eq { fn same(a:ro<Self>, b:ro<Self>) -> bool pure; }
pub trait Hash { fn hash(value:ro<Self>) -> u64 pure; }

// One implementation per class of scalars; a record gets its own with `derive eq`, `derive ord`, `derive hash`.
impl[T:integer] Ord for T { fn less(a:ro<T>, b:ro<T>) -> bool = a < b; }
impl[T:integer] Eq for T { fn same(a:ro<T>, b:ro<T>) -> bool = a == b; }
impl Eq for bool { fn same(a:ro<bool>, b:ro<bool>) -> bool = a == b; }

// Fibonacci hashing: one wrapping multiply, high bits carry the mix.
impl[T:unsigned] Hash for T {
  fn hash(value:ro<T>) -> u64 = mul_wrap(u64(value), 11400714819323198485);
}

// Each integer type's least and greatest value, so a bound is a name and not a literal of twenty digits:
// `if x > U64_MAX - y { ... }` tests an add before it traps. The least of an unsigned type is 0.
pub const U8_MAX:u8 = 255;
pub const U16_MAX:u16 = 65535;
pub const U32_MAX:u32 = 4294967295;
pub const U64_MAX:u64 = 18446744073709551615;
pub const USIZE_MAX:usize = 18446744073709551615;
pub const I8_MIN:i8 = -128;
pub const I8_MAX:i8 = 127;
pub const I16_MIN:i16 = -32768;
pub const I16_MAX:i16 = 32767;
pub const I32_MIN:i32 = -2147483648;
pub const I32_MAX:i32 = 2147483647;
pub const I64_MIN:i64 = -9223372036854775808;
pub const I64_MAX:i64 = 9223372036854775807;
