{
  "name": "cairn",
  "displayName": "CAIRN",
  "version": "0.9.0",
  "description": "Write, check, test and tune CAIRN programs: the language skill, the cairn command on PATH, the language server, so every edit to a .cairn file comes back with the compiler's diagnostics, and an MCP server with the compiler's guarded edit, plan and implementation hosts.",
  "author": {"name": "SamMausberg", "url": "https://github.com/SamMausberg"},
  "homepage": "https://github.com/SamMausberg/cairn",
  "repository": "https://github.com/SamMausberg/cairn",
  "license": "MIT OR Apache-2.0",
  "keywords": ["cairn", "language", "compiler", "systems", "cuda", "ownership", "effects"],
  "lspServers": {
    "cairn": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/cairn",
      "args": ["lsp"],
      "extensionToLanguage": {".cairn": "cairn"}
    }
  },
  "mcpServers": {
    "cairn": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/cairn",
      "args": ["mcp"]
    }
  },
  "experimental": {"evals": "bench/skill"}
}
