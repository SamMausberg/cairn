// The input helpers below are given; everything else is yours to write.
import std.core (Option, Result);
import std.io as io;
import std.text as text;
import std.vec (Vec);

struct Input { bytes:Vec[u8]; at:usize; }
struct Span { lo:usize; hi:usize; }

// All of standard input.
fn read_input() -> Input {
  let mut bytes = vec.new[u8]();
  stack chunk:u8[4096] = zeroed;
  let mut more = true;
  while more {
    match io.read_stdin(4096, chunk) {
      Ok(got) => {
        if got == 0 { more = false; } else { vec.extend_from(bytes, got, chunk[0..got]); }
      }
      Err(_) => more = false;
    }
  }
  return Input(bytes, 0);
}

// The next run of bytes that are not spaces, tabs or line ends, or None at the end of the input.
fn next_token(inp:rw<Input>) -> Option[Span] {
  let n = inp.bytes.len;
  let mut lo = inp.at;
  while lo < n && inp.bytes.data[lo] <= 32 { lo += 1; }
  if lo >= n { return None; }
  let mut hi = lo;
  while hi < n && inp.bytes.data[hi] > 32 { hi += 1; }
  inp.at = hi;
  return Some(Span(lo, hi));
}

// The next token as an unsigned integer; the input is well formed, so anything else is a guard failure.
fn next_u64(inp:rw<Input>) -> u64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_u64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an unsigned integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

// The next token as a signed integer.
fn next_i64(inp:rw<Input>) -> i64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_i64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

// Each block scans its own 256-element tile with a double-buffered Hillis-Steele
// scan over shared memory, waiting on a barrier between every step, then leaves
// the block's own total in sums[b].
fn block_scan(n:usize, x:ro<u64>[n]@device, g:usize, out:rw<u64>[n]@device, sums:rw<u64>[g]@device) {
  blocks b in g threads t in 256 {
    shared bufA:u64[256] = zeroed;
    shared bufB:u64[256] = zeroed;
    let i = b * 256 + t;
    if i < n { bufA[t] = x[i]; }
    barrier;
    for step in 0..8 {
      let offset:usize = shl_wrap(1, step);
      if step % 2 == 0 {
        if t >= offset { bufB[t] = bufA[t] + bufA[t - offset]; } else { bufB[t] = bufA[t]; }
      } else {
        if t >= offset { bufA[t] = bufB[t] + bufB[t - offset]; } else { bufA[t] = bufB[t]; }
      }
      barrier;
    }
    if i < n { out[i] = bufA[t]; }
    if t == 0 { sums[b] = bufA[255]; }
  }
}

// Adds each block's prior total, computed on the host from the exact per-block
// sums, to every element of that block.
fn add_offsets(n:usize, g:usize, out:rw<u64>[n]@device, offs:ro<u64>[g]@device) {
  blocks b in g threads t in 256 {
    let i = b * 256 + t;
    if i < n { out[i] = out[i] + offs[b]; }
  }
}

fn main() -> i32 {
  let mut inp = read_input();
  let n_u64 = next_u64(inp);
  let n:usize = usize(n_u64);
  if n == 0 { return 0; }
  let mut values = Buf[u64](n);
  for k in 0..n { values[k] = next_u64(inp); }

  let g:usize = (n + 255) / 256;
  buffer x:u64[n]@device = zeroed;
  buffer out:u64[n]@device = zeroed;
  buffer sums:u64[g]@device = zeroed;
  buffer offs:u64[g]@device = zeroed;

  transfer(x, values[0..n]);
  block_scan(n, x, g, out, sums);

  let mut host_sums = Buf[u64](g);
  transfer(host_sums[0..g], sums);
  let mut offsets = Buf[u64](g);
  let mut running:u64 = 0;
  for b in 0..g {
    offsets[b] = running;
    running += host_sums[b];
  }
  transfer(offs, offsets[0..g]);
  add_offsets(n, g, out, offs);

  let mut result = Buf[u64](n);
  transfer(result[0..n], out);
  for k in 0..n {
    io.print_u64(result[k]);
    io.newline();
  }
  return 0;
}
