fn rotate_xor_0(x:u64, key:u64) -> u64 {
  return ((shl_wrap(x, 1) | shr(x, 63)) ^ key);
}

fn rotate_xor_1(x:u64, key:u64) -> u64 {
  return ((shl_wrap(x, 2) | shr(x, 62)) ^ key);
}

fn rotate_xor_2(x:u64, key:u64) -> u64 {
  return ((shl_wrap(x, 3) | shr(x, 61)) ^ key);
}

fn rotate_xor_3(x:u64, key:u64) -> u64 {
  return ((shl_wrap(x, 4) | shr(x, 60)) ^ key);
}

fn rotate_xor_4(x:u64, key:u64) -> u64 {
  return ((shl_wrap(x, 5) | shr(x, 59)) ^ key);
}

fn rotate_xor_5(x:u64, key:u64) -> u64 {
  return ((shl_wrap(x, 6) | shr(x, 58)) ^ key);
}

fn rotate_xor_6(x:u64, key:u64) -> u64 {
  return ((shl_wrap(x, 7) | shr(x, 57)) ^ key);
}

fn rotate_xor_7(x:u64, key:u64) -> u64 {
  return ((shl_wrap(x, 8) | shr(x, 56)) ^ key);
}

fn delta_0(n:usize, out:rw<u64>[n]@host, x:ro<u64>[n]@host) {
  for i in 0..n {
    if (i == 0) {
      out[i] = x[i];
    }
    else {
      out[i] = sub_wrap(x[i], x[(i - 1)]);
    }
  }
}

