(set-logic QF_BV)
(declare-const arg_0 (_ BitVec 8))
(declare-const arg_1 (_ BitVec 8))
(define-fun term_0 () Bool (bvugt arg_0 arg_1))
(define-fun term_1 () (_ BitVec 8) (ite term_0 arg_0 (ite (not term_0) arg_1 (_ bv0 8))))
(define-fun term_2 () Bool (or term_0 (not term_0)))
(define-fun term_3 () (_ BitVec 8) (ite (bvule arg_0 arg_1) arg_1 arg_0))
(define-fun term_4 () (_ BitVec 8) term_3)
(assert (or (not (= term_2 true)) (and term_2 (not (= term_1 term_4)))))
(check-sat)
