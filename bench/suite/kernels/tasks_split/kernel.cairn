// Four visibly disjoint parts, each filled by its own thread. This prices CAIRN's task and lease
// form, which is a thread per part rather than a lane pool, against std::thread, OpenMP sections and
// tbb::parallel_invoke.
//
// Until every wait, nobody may touch what a task writes, and the four parts are visibly disjoint
// because each part ends where the next begins (docs/guide/language.md, Tasks and leases).
//
// K is four and not a variable. A ticket is linear and scope bound and has to be waited for on every
// path of the same function, so a spawn cannot sit in a loop, and four literal parts is what the
// language offers here.
fn fill_part(n:usize, out:rw<u64>[n], seed:u64) {
  for i in 0..n { out[i] = mul_wrap(add_wrap(seed, u64(i)), 2654435761); }
}

fn tasks_split(n:usize, out:rw<u64>[n], seed:u64) {
  let q1 = n / 4;
  let q2 = q1 + q1;
  let q3 = q2 + q1;
  let a = spawn fill_part(q1, out[0..q1], seed);
  let b = spawn fill_part(q1, out[q1..q2], add_wrap(seed, u64(q1)));
  let c = spawn fill_part(q1, out[q2..q3], add_wrap(seed, u64(q2)));
  let d = spawn fill_part(n - q3, out[q3..n], add_wrap(seed, u64(q3)));
  wait(a);
  wait(b);
  wait(c);
  wait(d);
}
