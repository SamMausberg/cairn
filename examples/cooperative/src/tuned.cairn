// Row sums two ways: one thread a row, and T threads a row, with T and a pipeline depth for `cairn tune` to search.

// out[r] is the sum of row r of x, rows of cols elements: the first thread of a block a row adds it in order.
fn row_totals(
  rows:usize, cols:usize, n:usize, x:ro<u64>[n]@device, out:rw<u64>[rows]@device
) effects(trap, ffi_precondition, read:x, write:out, par:device, local_read, local_write, zero_init) {
  blocks r in rows threads t in 32 {
    if t == 0 {
      let mut sum:u64 = 0;
      for c in 0..cols { sum += x[r * cols + c]; }
      out[r] = sum;
    }
  }
}

// The same sums, a block of T threads a row. The row comes through a pipeline of D stages of T elements, D - 1 of
// them on their way while the threads add one; then the block halves its T partial sums to one warp's 32.
fn row_totals_tiled[T:nat, D:nat](rows:usize, cols:usize, n:usize, x:ro<u64>[n]@device, out:rw<u64>[rows]@device)
  implements row_totals tune T in [128, 256], D in [2, 3] needs(cp_async) {
  let steps = (cols + T - 1) / T;
  blocks r in rows threads t in T {
    pipeline tiles:u64[T] depth D;
    shared partial:u64[T] = zeroed;
    for k in 0..D - 1 {
      let start = min(k * T, cols);
      tiles.fill(x, r * cols + start, min(T, cols - start));
    }
    let mut sum:u64 = 0;
    for k in 0..steps {
      let ahead = min((k + D - 1) * T, cols);
      tiles.fill(x, r * cols + ahead, min(T, cols - ahead));
      tiles.wait();
      sum += tiles[t];
      tiles.release();
      barrier;
    }
    partial[t] = sum;
    barrier;
    for k in 0..5 {
      let s:usize = shr(T, k + 1);
      if s >= 32 && t < s { partial[t] = partial[t] + partial[t + s]; }
      barrier;
    }
    if t < 32 {
      let total = reduce + warp yield partial[t];
      if t == 0 { out[r] = total; }
    }
  }
}

fn main() -> i32 {
  let rows:usize = 3;
  let cols:usize = 700;
  let n = rows * cols;
  buffer x:u64[n] = zeroed;
  for i in 0..n { x[i] = u64(i * 7 % 1009); }
  buffer dx:u64[n]@device = zeroed;
  buffer dout:u64[rows]@device = zeroed;
  transfer(dx, x);
  row_totals(rows, cols, n, dx, dout);
  buffer out:u64[rows] = zeroed;
  transfer(out, dout);
  for r in 0..rows {
    let mut want:u64 = 0;
    for c in 0..cols { want += x[r * cols + c]; }
    if out[r] != want { return 1; }
  }
  println("device: row totals agree with a plain loop");
  return 0;
}
