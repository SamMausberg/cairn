// The certified collector, against std::copy_if and against a parallel two pass compaction.
//
// `compact` writes the stable selected prefix into storage of capacity exactly n, leaves the tail
// beyond the returned count unchanged, allocates nothing on the host, and is sequential on the
// host. Its one store into the output is deliberately unguarded in the emitted C++, and that store
// is what the seventeen affine certificates of docs/internals/verification.md justify: the running
// index never leaves the capacity the parameter declares, so no bounds test is emitted for it and
// none is needed. Every baseline arm here therefore leaves its own store unguarded too, or the two
// sides would not be carrying the same boundary.
//
// The selection is data dependent, so no arm can hoist it: which elements survive is decided by the
// values, and a parallel arm has to count before it can scatter.
fn compact_even(n:usize, out:rw<u64>[n], x:ro<u64>[n]) -> usize {
  let used = compact out for i in n where (x[i] & 1) == 0 yield x[i];
  return used;
}
