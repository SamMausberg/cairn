(set-logic QF_BV)
(declare-const arg_0_0 (_ BitVec 64))
(declare-const arg_1_0 (_ BitVec 64))
(define-fun term_0 () Bool (bvult arg_0_0 arg_1_0))
(define-fun term_1 () (_ BitVec 64) (ite term_0 arg_0_0 (ite (not term_0) arg_1_0 (_ bv0 64))))
(define-fun term_2 () Bool (or term_0 (not term_0)))
(define-fun term_3 () Bool term_2)
(define-fun term_4 () (_ BitVec 64) (ite (bvule arg_0_0 arg_1_0) arg_1_0 arg_0_0))
(define-fun term_5 () (_ BitVec 64) term_4)
(assert (or (not (= term_3 true)) (and term_3 (not (= term_1 term_5)))))
(check-sat)
