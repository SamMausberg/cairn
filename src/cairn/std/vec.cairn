// A growable owner. Growth is the only allocation and it is visible in every caller's effect row.
module std.vec;
import std.core (Option);

pub struct Vec[T] { data:Buf[T]; len:usize; }

pub fn new[T]() -> Vec[T] = Vec(Buf[T](0), 0);
pub fn with_capacity[T](capacity:usize) -> Vec[T] = Vec(Buf[T](capacity), 0);
pub fn capacity[T](v:ro<Vec[T]>) -> usize = len(v.data);

// Doubling keeps pushes amortized constant; elements move by swap, so owners are never copied.
pub fn reserve[T](v:rw<Vec[T]>, wanted:usize) {
  if wanted <= len(v.data) { return; }
  let mut bigger = Buf[T](max(wanted, max(4, len(v.data) * 2)));
  for i in 0..v.len { swap(bigger[i], v.data[i]); }
  v.data = bigger;
}

pub fn push[T](v:rw<Vec[T]>, item:T) {
  reserve(v, v.len + 1);
  v.data[v.len] = item;
  v.len = v.len + 1;
}

pub fn pop[T](v:rw<Vec[T]>) -> Option[T] {
  // Option.None() and not Option.None: a bare variant is a place, and a place holding an owner
  // cannot be moved. The call spelling is the only one that compiles for every T.
  if v.len == 0 { return Option.None(); }
  v.len = v.len - 1;
  return Option.Some(take(v.data[v.len]));
}

pub fn get[T](v:ro<Vec[T]>, i:usize) -> T {
  if i >= v.len { return v.data[len(v.data)]; }
  return v.data[i];
}

pub fn set[T](v:rw<Vec[T]>, i:usize, item:T) {
  if i >= v.len { v.data[len(v.data)] = item; return; }
  v.data[i] = item;
}

pub fn clear[T](v:rw<Vec[T]>) {
  for i in 0..v.len { let dropped = take(v.data[i]); }
  v.len = 0;
}

// Append a view. Copying elements, so it instantiates only for copyable ones; an owner would
// have to be moved out of the source view, which no borrow allows.
pub fn extend_from[T](v:rw<Vec[T]>, n:usize, src:ro<T>[n]) {
  reserve(v, v.len + n);
  for i in 0..n { v.data[v.len + i] = src[i]; }
  v.len = v.len + n;
}

// Release the tail now instead of at the owner's scope exit; capacity is kept.
pub fn truncate[T](v:rw<Vec[T]>, count:usize) {
  if count >= v.len { return; }
  for i in count..v.len { let dropped = take(v.data[i]); }
  v.len = count;
}
