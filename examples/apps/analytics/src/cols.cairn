// The four generators this engine is built from. Each one is ordinary CAIRN over a record
// schema: a structure-of-arrays table, the per-column statistics of that table, column kernels
// whose unroll factor is a natural, and the same reductions over device views.
module analytics.cols;

// Generated code reaches this by its full path. Privacy is judged where `derive` is written,
// so a recipe may only call what the deriving module could have called itself.
pub fn chain(seed:u64, value:u64) -> u64 pure = mul_wrap(seed ^ value, 1099511628211);

// columns/1: one Buf per field, plus the row count the columns were built for. `width` is the
// row's width on the wire, folded over the fields at expansion time, because the codecs pack
// it with no padding.
pub recipe columns for R where width = fold + each f in R { bytes(f) }, arity = count(R) {
  each f in R {
    require unsigned(f), "E-DERIVE-DOMAIN: columns/1 stores unsigned scalar columns.";
  }
  pub struct $R_table {
    rows:usize;
    each f in R where t = typeof(f) { $f:Buf[$t][rows]; } // each column holds `rows` elements, by declaration
  }
  pub fn $R_table_new(rows:usize) -> $R_table = $R_table(
    rows, each f in R where t = typeof(f) { Buf[$t](rows) }
  );
  pub fn $R_get(c:ro<$R_table>, i:usize) -> R = R(each f in R { c.$f[i] });
  pub fn $R_set(c:rw<$R_table>, i:usize, row:R) { each f in R { c.$f[i] = row.$f; } }
  // Order-independent row digest: every field mixed with its own position, joined by xor.
  pub fn $R_key(row:ro<R>) -> u64 pure = fold ^ each f in R where at = index(f) {
    cols.chain(u64($at) + 1, u64(row.$f))
  };
  pub fn $R_row_bytes() -> usize pure = $width;
  pub fn $R_arity() -> usize pure = $arity;
}

// stats/1: the smallest, largest and total of every column, in one record laid out column by
// column — three facts per field, in the schema's own order, because an `each` among a field
// list or a constructor's arguments may splice several per step. The totals come in two
// flavours because they are two claims: `reduce +` traps if the total does not fit, and
// `reduce add_wrap` is exact in any association order, so a device tree reduction may be held
// to it.
pub recipe stats for R {
  each f in R {
    require unsigned(f), "E-DERIVE-DOMAIN: stats/1 summarises unsigned scalar columns.";
  }
  pub struct $R_summary {
    each f in R where t = typeof(f) { min_$f:$t; max_$f:$t; sum_$f:u64; }
    rows:usize;
  }
  each f in R where t = typeof(f) {
    pub fn $R_min_$f(n:usize, c:ro<$R_table>) -> $t {
      if n == 0 { return $t(0); }
      let mut best:$t = c.$f[0];
      for i in 1..n { best = min(best, c.$f[i]); }
      return best;
    }
    pub fn $R_max_$f(n:usize, c:ro<$R_table>) -> $t {
      if n == 0 { return $t(0); }
      let mut best:$t = c.$f[0];
      for i in 1..n { best = max(best, c.$f[i]); }
      return best;
    }
    // Checked: the caller learns that the total fits by not trapping.
    pub fn $R_total_$f(n:usize, c:ro<$R_table>) -> u64 {
      let total = reduce + for i in n yield u64(c.$f[i]);
      return total;
    }
    // Wrapping: exact under any association, so a device reduction may be compared to it.
    pub fn $R_wrapping_$f(n:usize, c:ro<$R_table>) -> u64 {
      let total = reduce add_wrap for i in n yield u64(c.$f[i]);
      return total;
    }
  }
  pub fn $R_summarize(n:usize, c:ro<$R_table>) -> $R_summary = $R_summary(
    each f in R { $R_min_$f(n, c), $R_max_$f(n, c), $R_total_$f(n, c) }, n
  );
}

// device_columns/1: the column totals again over @device views. The bodies are the ones in
// stats/1 with the placement changed — the whole difference between a host fold and a device
// tree reduction — and the names are the same, because the module they land in says which side
// they run on. Derive it only where a device build is wanted: one @device view sends the
// entire program through nvcc.
pub recipe device_columns for R {
  each f in R {
    require unsigned(f), "E-DERIVE-DOMAIN: device_columns/1 summarises unsigned scalar columns.";
  }
  each f in R where t = typeof(f) {
    pub fn $R_wrapping_$f(n:usize, col:ro<$t>[n]@device) -> u64 {
      let total = reduce add_wrap for i in n yield u64(col[i]);
      return total;
    }
    pub fn $R_total_$f(n:usize, col:ro<$t>[n]@device) -> u64 {
      let total = reduce + for i in n yield u64(col[i]);
      return total;
    }
  }
}

// unrolled/1: K accumulators per column, unrolled at expansion time and joined by a fold over
// the same static range. The natural is all that separates a two-way kernel from a sixteen.
pub recipe unrolled[K:nat] for R {
  require K >= 1, "E-DERIVE-DOMAIN: unrolled/1 needs at least one accumulator.";
  require K <= 16, "E-DERIVE-DOMAIN: unrolled/1 stops at sixteen accumulators.";
  each f in R {
    pub fn $R_unrolled_$f(n:usize, c:ro<$R_table>) -> u64 {
      each k in 0..K { let mut acc_$k:u64 = 0; }
      let mut i:usize = 0;
      while i + $K <= n {
        each k in 0..K { acc_$k = add_wrap(acc_$k, u64(c.$f[i + $k])); }
        i = i + $K;
      }
      let mut total:u64 = fold add_wrap each k in 0..K { acc_$k };
      while i < n {
        total = add_wrap(total, u64(c.$f[i]));
        i = i + 1;
      }
      return total;
    }
  }
  pub fn $R_unroll_factor() -> usize pure = $K;
}
