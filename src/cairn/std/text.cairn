// Numbers to bytes and back, the ASCII class of a byte, and the searching a line protocol needs.
// A substring cannot be returned (a borrow is second class), so every search answers with an index
// into the input and the caller passes the part `s[lo..hi]` onwards.
// Cost: one pass per call; the write_* forms touch only the caller's storage and return the
// number of bytes used, or 0 when the value does not fit. The push_* forms grow a Vec.
module std.text;
import std.core (Option, Result, U64_MAX);
import std.vec (Vec);

pub enum ParseError { Empty; Invalid(usize); Overflow(usize); }

// One byte's ASCII class, as C's <ctype.h> answers it in the "C" locale: a byte above 127 is in none.
// Cost: a comparison or two; nothing is read but the byte.
pub fn is_digit(c:u8) -> bool = c >= '0' && c <= '9';
pub fn is_upper(c:u8) -> bool = c >= 'A' && c <= 'Z';
pub fn is_lower(c:u8) -> bool = c >= 'a' && c <= 'z';
pub fn is_alpha(c:u8) -> bool = is_upper(c) || is_lower(c);
pub fn is_alnum(c:u8) -> bool = is_alpha(c) || is_digit(c);
// ' ' and the five controls from 9 to 13: '\t', '\n', vertical tab, form feed and '\r'.
pub fn is_space(c:u8) -> bool = c == ' ' || (c >= 9 && c <= 13);

// A letter in the other case, by its case bit; every other byte as it is.
pub fn to_lower(c:u8) -> u8 {
  if is_upper(c) { return c | 32; }
  return c;
}
pub fn to_upper(c:u8) -> u8 {
  if is_lower(c) { return c & 223; }
  return c;
}

// The decimal digits of s[start..n], all but the byte at `skip`, as a value no larger than `limit`, or the
// offset of the byte at fault.
fn digits(n:usize, s:ro<u8>[n], start:usize, skip:usize, limit:u64) -> Result[u64, ParseError] {
  let mut value = 0;
  for i in start..n {
    if i == skip { continue; }
    let byte = s[i];
    if byte < 48 || byte > 57 { return Err(Invalid(i)); }
    let digit = u64(byte - 48);
    if value > (limit - digit) / 10 { return Err(Overflow(i)); }
    value = value * 10 + digit;
  }
  return Ok(value);
}

// Decimal digits and nothing else: no sign, no '+', no spaces around them.
pub fn parse_u64(n:usize, s:ro<u8>[n]) -> Result[u64, ParseError] {
  if n == 0 { return Err(Empty); }
  return digits(s, 0, n, U64_MAX);
}

// Signed decimal: an optional leading '-', then digits. The magnitude may reach 2^63 only when
// negative, and the error offset names the byte at fault as parse_u64 does.
pub fn parse_i64(n:usize, s:ro<u8>[n]) -> Result[i64, ParseError] {
  if n == 0 { return Err(Empty); }
  let negative = s[0] == 45;
  let mut start:usize = 0;
  if negative { start = 1; }
  if start == n { return Err(Invalid(start)); }
  let mut limit:u64 = 9223372036854775807;
  if negative { limit = 9223372036854775808; }
  let value = try digits(s, start, n, limit);
  if !negative { return Ok(i64(value)); }
  if value == 0 { return Ok(0); }
  let below = i64(value - 1); // value - 1 fits an i64 even when value is 2^63
  return Ok(-below - 1);
}

// A place in a view that next_line, next_word and next_field move forward. Each finds the next piece at
// or after `at`, sets `lo..hi` to its bounds and moves `at` past it, so the piece is the part s[c.lo..c.hi]
// and nothing is copied: `let mut w = text.cursor(); while text.next_word(input, w) { ... }`.
pub struct Cursor { at:usize; lo:usize; hi:usize; }

pub fn cursor() -> Cursor = Cursor(0, 0, 0);

// The next line, without its "\n" or "\r\n". A last line without "\n" counts, and an empty view has none.
// Cost: one pass over the line.
pub fn next_line(n:usize, s:ro<u8>[n], c:rw<Cursor>) -> bool {
  if c.at >= n { return false; }
  c.lo = c.at;
  let mut i = c.at;
  while i < n && s[i] != '\n' { i += 1; }
  c.at = i + 1;
  if i < n && i > c.lo && s[i - 1] == '\r' { i -= 1; }
  c.hi = i;
  return true;
}

// The next word: a run of bytes that are not is_space, which separates words and is skipped.
// Cost: one pass over the word and the space before it.
pub fn next_word(n:usize, s:ro<u8>[n], c:rw<Cursor>) -> bool {
  let mut i = c.at;
  while i < n && is_space(s[i]) { i += 1; }
  if i >= n {
    c.at = i;
    return false;
  }
  c.lo = i;
  while i < n && !is_space(s[i]) { i += 1; }
  c.hi = i;
  c.at = i;
  return true;
}

// The next field of a view split at every `sep`, as a line of comma-separated values is: "a,,b" has three
// fields, the second empty, and an empty view has one, which is empty.
// Cost: one pass over the field.
pub fn next_field(n:usize, s:ro<u8>[n], sep:u8, c:rw<Cursor>) -> bool {
  if c.at > n { return false; }
  c.lo = c.at;
  let mut i = c.at;
  while i < n && s[i] != sep { i += 1; }
  c.hi = i;
  c.at = i + 1;
  return true;
}

// A decimal with at most `places` digits after an optional '.', as a count of units of 10^-places: with
// two places "12.5" and "12.50" are 1250 and "12" is 1200. Digits only, as parse_u64 takes them, with one
// or more on each side of a point; a digit past `places` is Invalid, and a value past U64_MAX is Overflow.
// Cost: one pass; `places` less the digits written must be at most 19, or the scale traps.
pub fn parse_fixed(n:usize, s:ro<u8>[n], places:usize) -> Result[u64, ParseError] {
  if n == 0 { return Err(Empty); }
  let mut point = n;
  match find_byte(n, s, '.', 0) { Some(at) => point = at; None => {} }
  if point == 0 || point + 1 == n { return Err(Invalid(point)); }
  let raw = try digits(s, 0, point, U64_MAX);
  let shown = n - min(n, point + 1);
  if shown > places { return Err(Invalid(point + 1 + places)); }
  let mut unit:u64 = 1;
  for _ in shown..places { unit *= 10; }
  if raw > U64_MAX / unit { return Err(Overflow(n - 1)); }
  return Ok(raw * unit);
}

// Decimal, most significant digit first. The digits are produced backwards into fixed storage,
// so the caller's buffer is written once and never partially.
pub fn write_u64(n:usize, out:rw<u8>[n], value:u64) -> usize {
  stack digits:u8[20] = zeroed;
  let mut rest = value;
  let mut used:usize = 0;
  while used == 0 || rest > 0 {
    digits[used] = u8(rest % 10 + 48);
    rest /= 10;
    used += 1;
  }
  if used > n { return 0; }
  for i in 0..used { out[i] = digits[used - 1 - i]; }
  return used;
}

// A leading '-' and the magnitude, which is representable for every value, the minimum included.
pub fn write_i64(n:usize, out:rw<u8>[n], value:i64) -> usize {
  if value >= 0 { return write_u64(out, u64(value)); }
  let magnitude = u64(-(value + 1)) + 1;
  stack digits:u8[20] = zeroed;
  let used = write_u64(digits, magnitude);
  if used + 1 > n { return 0; }
  out[0] = 45;
  for i in 0..used { out[i + 1] = digits[i]; }
  return used + 1;
}

// Exactly `width` lowercase hex digits, high nibble first; the high bits above `width` are lost.
pub fn write_hex(n:usize, out:rw<u8>[n], value:u64, width:usize) -> usize {
  if width == 0 || width > 16 || width > n { return 0; }
  for i in 0..width {
    let nibble = u8(shr(value, (width - 1 - i) * 4) & 15);
    if nibble < 10 { out[i] = nibble + 48; } else { out[i] = nibble + 87; }
  }
  return width;
}

pub fn push_u64(v:rw<Vec[u8]>, value:u64) {
  stack digits:u8[20] = zeroed;
  let used = write_u64(digits, value);
  vec.extend_from(v, used, digits[0..used]);
}

pub fn push_i64(v:rw<Vec[u8]>, value:i64) {
  stack digits:u8[21] = zeroed;
  let used = write_i64(digits, value);
  vec.extend_from(v, used, digits[0..used]);
}

// Lexicographic order on bytes, shorter first on a common prefix: -1, 0 or 1.
pub fn compare(n:usize, a:ro<u8>[n], m:usize, b:ro<u8>[m]) -> i32 {
  let mut i:usize = 0;
  while i < n && i < m {
    if a[i] != b[i] { if a[i] < b[i] { return -1; } return 1; }
    i += 1;
  }
  if n < m { return -1; }
  if n > m { return 1; }
  return 0;
}

pub fn equal(n:usize, a:ro<u8>[n], m:usize, b:ro<u8>[m]) -> bool = compare(a, b) == 0;

pub fn starts_with(n:usize, s:ro<u8>[n], m:usize, prefix:ro<u8>[m]) -> bool {
  if m > n { return false; }
  return equal(s[0..m], prefix);
}

pub fn ends_with(n:usize, s:ro<u8>[n], m:usize, suffix:ro<u8>[m]) -> bool {
  if m > n { return false; }
  return equal(m, s[n - m..n], m, suffix);
}

pub fn find_byte(n:usize, s:ro<u8>[n], byte:u8, from:usize) -> Option[usize] {
  for i in from..n { if s[i] == byte { return Some(i); } }
  return None;
}

// The last index holding `byte`, which is where a path's extension or a line's last field begins.
pub fn find_last_byte(n:usize, s:ro<u8>[n], byte:u8) -> Option[usize] {
  let mut i = n;
  while i > 0 {
    i -= 1;
    if s[i] == byte { return Some(i); }
  }
  return None;
}

// The first index where `needle` starts. Naive, because a line protocol's needles are short.
pub fn find(n:usize, s:ro<u8>[n], m:usize, needle:ro<u8>[m]) -> Option[usize] {
  if m == 0 || m > n { return None; }
  for start in 0..n - m + 1 {
    let mut matched:usize = 0;
    while matched < m && s[start + matched] == needle[matched] { matched += 1; }
    if matched == m { return Some(start); }
  }
  return None;
}

// FNV-1a: no table, no allocation, good enough to key a map or checksum a record.
pub fn hash_bytes(n:usize, s:ro<u8>[n]) -> u64 {
  let mut h = 14695981039346656037;
  for x in s { h = mul_wrap(h ^ u64(x), 1099511628211); }
  return h;
}
