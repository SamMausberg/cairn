// The input helpers below are given; everything else is yours to write.
import std.core (Option, Result);
import std.io as io;
import std.text as text;
import std.vec (Vec);

struct Input { bytes:Vec[u8]; at:usize; }
struct Span { lo:usize; hi:usize; }

// All of standard input.
fn read_input() -> Input {
  let mut bytes = vec.new[u8]();
  stack chunk:u8[4096] = zeroed;
  let mut more = true;
  while more {
    match io.read_stdin(4096, chunk) {
      Ok(got) => {
        if got == 0 { more = false; } else { vec.extend_from(bytes, got, chunk[0..got]); }
      }
      Err(_) => more = false;
    }
  }
  return Input(bytes, 0);
}

// The next run of bytes that are not spaces, tabs or line ends, or None at the end of the input.
fn next_token(inp:rw<Input>) -> Option[Span] {
  let n = inp.bytes.len;
  let mut lo = inp.at;
  while lo < n && inp.bytes.data[lo] <= 32 { lo += 1; }
  if lo >= n { return None; }
  let mut hi = lo;
  while hi < n && inp.bytes.data[hi] > 32 { hi += 1; }
  inp.at = hi;
  return Some(Span(lo, hi));
}

// The next token as an unsigned integer; the input is well formed, so anything else is a guard failure.
fn next_u64(inp:rw<Input>) -> u64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_u64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an unsigned integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

// The next token as a signed integer.
fn next_i64(inp:rw<Input>) -> i64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_i64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

// Whether the token s reads exactly as the literal word.
fn word_is(inp:ro<Input>, s:Span, k:usize, word:ro<u8>[k]) -> bool =
  text.equal(s.hi - s.lo, inp.bytes.data[s.lo..s.hi], k, word);

// One numbered slot of the pool: its current buffer (when occupied), and how many
// buffers this slot has ever held, which is the generation of whichever one is current.
struct Slot { buf:Vec[u8]; generation:u64; occupied:bool; }
struct Pool { slots:Vec[Slot]; free:Vec[usize]; live_count:u64; live_bytes:u64; }

// A binary min-heap of slot numbers, so `new` always finds the lowest-numbered free slot.
fn heap_push(heap:rw<Vec[usize]>, value:usize) {
  vec.push(heap, value);
  let mut i = heap.len - 1;
  while i > 0 {
    let parent = (i - 1) / 2;
    let pv = vec.get(heap, parent);
    let cv = vec.get(heap, i);
    if pv <= cv { break; }
    vec.set(heap, parent, cv);
    vec.set(heap, i, pv);
    i = parent;
  }
}

fn heap_pop_min(heap:rw<Vec[usize]>) -> usize {
  let n = heap.len;
  let top = vec.get(heap, 0);
  let lastv = vec.get(heap, n - 1);
  vec.set(heap, 0, lastv);
  vec.truncate(heap, n - 1);
  let m = heap.len;
  let mut i:usize = 0;
  while true {
    let l = 2 * i + 1;
    let r = 2 * i + 2;
    let mut smallest = i;
    if l < m && vec.get(heap, l) < vec.get(heap, smallest) { smallest = l; }
    if r < m && vec.get(heap, r) < vec.get(heap, smallest) { smallest = r; }
    if smallest == i { break; }
    let tmp = vec.get(heap, i);
    vec.set(heap, i, vec.get(heap, smallest));
    vec.set(heap, smallest, tmp);
    i = smallest;
  }
  return top;
}

fn is_live(pool:ro<Pool>, slot:usize, gen:u64) -> bool {
  if slot >= pool.slots.len { return false; }
  return pool.slots.data[slot].occupied && pool.slots.data[slot].generation == gen;
}

fn do_new(pool:rw<Pool>, size:u64) {
  let mut slot:usize = 0;
  if pool.free.len > 0 {
    slot = heap_pop_min(pool.free);
  } else {
    slot = pool.slots.len;
    let empty = vec.new[u8]();
    vec.push(pool.slots, Slot(empty, 0, false));
  }
  let mut buf = vec.new[u8]();
  for k in 0..usize(size) { vec.push(buf, 0); }
  let gen = pool.slots.data[slot].generation + 1;
  pool.slots.data[slot].generation = gen;
  pool.slots.data[slot].occupied = true;
  pool.slots.data[slot].buf = buf;
  pool.live_count += 1;
  pool.live_bytes += size;
  println("h ", slot, " ", gen);
}

fn do_set(pool:rw<Pool>, i:u64, g:u64, off:u64, v:u64) {
  let slot = usize(i);
  if !is_live(pool, slot, g) { println("stale"); return; }
  let sz = u64(pool.slots.data[slot].buf.len);
  if off >= sz { println("bounds"); return; }
  pool.slots.data[slot].buf.data[usize(off)] = u8(v);
  println("ok");
}

fn do_sum(pool:ro<Pool>, i:u64, g:u64) {
  let slot = usize(i);
  if !is_live(pool, slot, g) { println("stale"); return; }
  let mut total:u64 = 0;
  let n = pool.slots.data[slot].buf.len;
  for k in 0..n { total += u64(pool.slots.data[slot].buf.data[k]); }
  println(total);
}

fn do_move(pool:rw<Pool>, i:u64, g:u64, j:u64, h:u64) {
  let si = usize(i);
  let sj = usize(j);
  if !is_live(pool, si, g) || !is_live(pool, sj, h) { println("stale"); return; }
  if i == j && g == h { println("same"); return; }
  let moved = take(pool.slots.data[si].buf);
  let ilen = moved.len;
  vec.extend_from(pool.slots.data[sj].buf, ilen, moved.data[0..ilen]);
  pool.slots.data[si].occupied = false;
  pool.live_count -= 1;
  heap_push(pool.free, si);
  let newsize = pool.slots.data[sj].buf.len;
  println("ok ", newsize);
}

fn do_free(pool:rw<Pool>, i:u64, g:u64) {
  let slot = usize(i);
  if !is_live(pool, slot, g) { println("stale"); return; }
  let sz = pool.slots.data[slot].buf.len;
  pool.slots.data[slot].occupied = false;
  let empty = vec.new[u8]();
  pool.slots.data[slot].buf = empty;
  pool.live_count -= 1;
  pool.live_bytes -= u64(sz);
  heap_push(pool.free, slot);
  println("ok");
}

fn main() -> i32 {
  let mut inp = read_input();
  let mut slots = vec.new[Slot]();
  let mut free = vec.new[usize]();
  let mut pool = Pool(slots, free, 0, 0);
  while true {
    match next_token(inp) {
      Some(s) => {
        if word_is(inp, s, len("new"), "new") {
          let size = next_u64(inp);
          do_new(pool, size);
        } else if word_is(inp, s, len("set"), "set") {
          let i = next_u64(inp);
          let g = next_u64(inp);
          let off = next_u64(inp);
          let v = next_u64(inp);
          do_set(pool, i, g, off, v);
        } else if word_is(inp, s, len("sum"), "sum") {
          let i = next_u64(inp);
          let g = next_u64(inp);
          do_sum(pool, i, g);
        } else if word_is(inp, s, len("move"), "move") {
          let i = next_u64(inp);
          let g = next_u64(inp);
          let j = next_u64(inp);
          let h = next_u64(inp);
          do_move(pool, i, g, j, h);
        } else if word_is(inp, s, len("free"), "free") {
          let i = next_u64(inp);
          let g = next_u64(inp);
          do_free(pool, i, g);
        } else {
          assert(false, "unknown command");
        }
      }
      None => break;
    }
  }
  println("live ", pool.live_count, " ", pool.live_bytes);
  return 0;
}
