// The query layer: filter, aggregate and group by, each one written twice over so the program
// can disagree with itself. Nothing here knows which schema it serves; the columns arrive as
// plain views taken from a generated table.
module analytics.query;

// --- filter ---------------------------------------------------------------------------------

// Stable selection into storage of exactly the input's capacity; the tail is left alone.
pub fn above(n:usize, out:rw<u64>[n], price:ro<u64>[n], limit:u64) -> usize {
  let used = compact out for i in n where price[i] >= limit yield price[i];
  return used;
}

pub fn above_loop(n:usize, out:rw<u64>[n], price:ro<u64>[n], limit:u64) -> usize {
  let mut used:usize = 0;
  for i in 0..n {
    if price[i] >= limit {
      out[used] = price[i];
      used += 1;
    }
  }
  return used;
}

// --- totals ---------------------------------------------------------------------------------

// Checked: a total that does not fit traps instead of wrapping, in any association order.
pub fn checked_total(n:usize, qty:ro<u32>[n]) -> u64 {
  let total = reduce + for i in n yield u64(qty[i]);
  return total;
}

// Wrapping: the only thing a device tree reduction can be held to bit for bit.
pub fn wrapping_total(n:usize, price:ro<u64>[n]) -> u64 {
  let total = reduce add_wrap for i in n yield price[i];
  return total;
}

// --- derived columns --------------------------------------------------------------------------

pub fn notional_loop(n:usize, out:rw<u64>[n], price:ro<u64>[n], qty:ro<u32>[n]) {
  for i in 0..n { out[i] = mul_wrap(price[i], u64(qty[i])); }
}

// One lane per row. The body is the same expression; only the statement changed.
pub fn notional_par(n:usize, out:rw<u64>[n], price:ro<u64>[n], qty:ro<u32>[n]) {
  parallel i in n { out[i] = mul_wrap(price[i], u64(qty[i])); }
}

// A map whose lanes call the caller's closure: `lane:f` in the row says so, and whatever is
// passed is judged where it is written. Reading `src[i]` by value is what asks `T` to be
// copyable; the output is only ever assigned over, which `affine` covers.
pub fn map_par[T:copy, U:affine](n:usize, out:rw<U>[n], src:ro<T>[n], f:ro<fn(T) -> U>) {
  parallel i in n { out[i] = f(src[i]); }
}

pub fn map_loop[T:copy, U:affine](n:usize, out:rw<U>[n], src:ro<T>[n], f:ro<fn(T) -> U>) {
  for i in 0..n { out[i] = f(src[i]); }
}

// --- group by ---------------------------------------------------------------------------------

// One pass, one bin per venue. This is the shape a `parallel` region may not take: every lane
// would write a bin another lane also writes, which is exactly what E-PARALLEL-RACE forbids.
pub fn venue_sums(
  rows:usize, venue:ro<u8>[rows], price:ro<u64>[rows], bins:usize, acc:rw<u64>[bins]
) {
  for i in 0..rows {
    let slot = usize(venue[i]) % bins;
    acc[slot] = add_wrap(acc[slot], price[i]);
  }
}

// The same group-by as four tasks over four visibly disjoint row ranges and four disjoint bin
// blocks of one scratch buffer, merged afterwards. A part ends where the next begins, which is
// what lets the checker lend all four mutably at once.
pub fn venue_sums_tasks(
  rows:usize, venue:ro<u8>[rows], price:ro<u64>[rows], bins:usize, acc:rw<u64>[bins]
) {
  let q1 = rows / 4;
  let q2 = rows / 2;
  let q3 = q1 + q2;
  let b1 = bins;
  let b2 = bins * 2;
  let b3 = bins * 3;
  let b4 = bins * 4;
  let mut scratch = Buf[u64](b4);
  let t0 = spawn venue_sums(q1, venue[0..q1], price[0..q1], bins, scratch[0..b1]);
  let t1 = spawn venue_sums(q2 - q1, venue[q1..q2], price[q1..q2], bins, scratch[b1..b2]);
  let t2 = spawn venue_sums(q3 - q2, venue[q2..q3], price[q2..q3], bins, scratch[b2..b3]);
  let t3 = spawn venue_sums(rows - q3, venue[q3..rows], price[q3..rows], bins, scratch[b3..b4]);
  wait(t0);
  wait(t1);
  wait(t2);
  wait(t3);
  for p in 0..4 {
    for b in 0..bins { acc[b] = add_wrap(acc[b], scratch[p * bins + b]); }
  }
}
