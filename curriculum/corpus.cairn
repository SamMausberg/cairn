fn clamp_0(x:u64) -> u64 {
  return min(max(x, 2), 3);
}

fn clamp_1(x:u64) -> u64 {
  return min(max(x, 3), 7);
}

fn clamp_2(x:u64) -> u64 {
  return min(max(x, 4), 11);
}

fn clamp_3(x:u64) -> u64 {
  return min(max(x, 5), 15);
}

fn clamp_4(x:u64) -> u64 {
  return min(max(x, 6), 19);
}

fn clamp_5(x:u64) -> u64 {
  return min(max(x, 7), 23);
}

fn clamp_6(x:u64) -> u64 {
  return min(max(x, 8), 27);
}

fn clamp_7(x:u64) -> u64 {
  return min(max(x, 9), 31);
}

fn interval_0(n:usize, x:ro<u64>[n]@host, lo:u64, hi:u64) -> usize {
  let mut total:usize = 0;
  for i in 0..n {
    if ((x[i] >= lo) && (x[i] < hi)) {
      total = add_wrap(total, 1);
    }
  }
  return total;
}

