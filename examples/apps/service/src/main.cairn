// A line protocol over TCP on the loopback address, served to many clients at once from one thread:
//   put <key> <value>  ->  +ok          get <key>  ->  = <value>   or  -missing
//   del <key>          ->  +ok/-missing quit       ->  +bye, and the service stops
// One I/O ring holds the accept and every client's receive in flight together, and hands each back as
// it finishes; nothing here is a thread. A reply is one blocking send, since a line fits the socket.
// Overload is an answer, never a trap: a client past the table hears -busy, a failed accept (no
// descriptor left) waits a moment before the next, and a kernel without io_uring is reported and ends it.
import std.core (Result);
import std.io (IoError);
import std.net (Socket);
import std.sys;
import std.text;
import std.vec (Vec);

const PORT:u16 = 39800;
const LIMIT:usize = 4096;
const CLIENTS:usize = 32;
const ACCEPT:u64 = 0; // the tag of the one accept in flight; client k's receive is tagged k + 1
const RETRY:u64 = u64(CLIENTS) + 1; // the pause after a failed accept, before the next one
const PAUSE:u64 = 10000000; // ten milliseconds

// One client: whether the slot is taken, its descriptor, and the bytes of a line not yet complete.
struct Client { live:bool; fd:i32; have:usize; line:Buf[u8]; }

// The end of the word starting at `from`: the next space, or the end of the line.
fn word_end(n:usize, line:ro<u8>[n], from:usize) -> usize {
  match text.find_byte(line, ' ', from) {
    Some(at) => return at;
    None => return n;
  }
}

fn say(fd:i32, n:usize, message:ro<u8>[n]) -> Result[usize, IoError] {
  let body = try net.send_all(fd, message);
  let end = try net.send_all(fd, "\n");
  return Ok(body + end);
}

// One request. The answer goes back on `fd`; `true` means the client asked the service to stop.
fn respond(fd:i32, t:rw<Table>, n:usize, line:ro<u8>[n]) -> Result[bool, IoError] {
  let verb = word_end(line, 0);
  if text.equal(line[0..verb], "quit") {
    try say(fd, "+bye");
    return Ok(true);
  }
  if verb >= n {
    let bad = try say(fd, "-error");
    return Ok(false);
  }
  let key_lo = verb + 1;
  let key_hi = word_end(line, key_lo);
  let k = key_hi - key_lo;
  if k == 0 {
    let bad = try say(fd, "-error");
    return Ok(false);
  }
  if text.equal(line[0..verb], "put") && key_hi < n {
    let value_lo = key_hi + 1;
    let v = n - value_lo;
    put(t, k, line[key_lo..key_hi], v, line[value_lo..n]);
    let ok = try say(fd, "+ok");
    return Ok(false);
  }
  if text.equal(line[0..verb], "get") {
    match find(t, k, line[key_lo..key_hi]) {
      Some(slot) => {
        let mut out = vec.new[u8]();
        out.push('=');
        out.push(' ');
        let v = t.index.vals[slot].value.len;
        out.extend_from(v, t.index.vals[slot].value.data[0..v]);
        let sent = try say(fd, out);
      }
      None => { let missing = try say(fd, "-missing"); }
    }
    return Ok(false);
  }
  if text.equal(line[0..verb], "del") {
    if erase(t, k, line[key_lo..key_hi]) {
      try say(fd, "+ok");
    } else {
      try say(fd, "-missing");
    }
    return Ok(false);
  }
  let bad = try say(fd, "-error");
  return Ok(false);
}

// A slot for a client the ring's accept answered, and its first receive; a full table says so and closes.
fn admit(q:rw<IoRing>, clients:rw<Buf[Client]>, fd:i32) {
  for k in 0..CLIENTS {
    if !clients[k].live && q.room() > 0 {
      clients[k] = Client(true, fd, 0, Buf[u8](LIMIT));
      let first = Buf[u8](LIMIT);
      q.recv(fd, first, LIMIT, u64(k) + 1);
      return;
    }
  }
  match say(fd, "-busy") {
    Ok(_) => {}
    Err(_) => {} // it is being turned away either way
  }
  unsafe { sys.close(fd); }
}

fn hang_up(clients:rw<Buf[Client]>, k:usize) {
  unsafe { let closed = sys.close(clients[k].fd); }
  clients[k].live = false; // its line buffer is released when the slot is reused
}

// What one receive brought: appended to the client's pending line, then every complete line answered.
// A line longer than LIMIT is answered with an error and dropped. `true` means a client said quit.
fn take_in(c:rw<Client>, t:rw<Table>, n:usize, got:ro<u8>[n]) -> Result[bool, IoError] {
  for g in got {
    if c.have == LIMIT {
      try say(c.fd, "-error");
      c.have = 0;
    }
    c.line[c.have] = g;
    c.have += 1;
  }
  let mut stop = false;
  while !stop {
    match text.find_byte(c.have, c.line[0..c.have], '\n', 0) {
      Some(at) => {
        stop = try respond(c.fd, t, c.line[0..at]);
        let rest = c.have - (at + 1);
        for i in 0..rest { c.line[i] = c.line[at + 1 + i]; }
        c.have = rest;
      }
      None => return Ok(false);
    }
  }
  return Ok(true);
}

fn run() -> Result[usize, IoError] {
  let server = try net.listen_on("\x7f\x00\x00\x01", PORT, 16);
  defer net.close(server);
  let mut q = IoRing(CLIENTS + 1);
  defer wait(q); // after the cancels below, this collects what they stopped
  match io.outcome(q.status()) {
    Ok(_) => {}
    Err(e) => { // a seccomp filter, a sysctl or no descriptor left: say so rather than serve nobody
      io.print("service: no io_uring here, errno ");
      io.print_u64(u64(e.code));
      io.newline();
      return Ok(2);
    }
  }
  let mut t = new_table();
  io.print("service: listening on ");
  io.print_u64(u64(PORT));
  io.newline();
  let mut clients = Buf[Client](CLIENTS);
  q.accept(server.fd, ACCEPT);
  let mut running = true;
  while running {
    let mut tag:u64 = 0;
    let mut result:i64 = 0;
    let data = q.next(tag, result); // whichever of them finished first
    if tag == ACCEPT && result < 0 {
      q.timeout(PAUSE, RETRY); // out of descriptors, most likely: an accept now would fail at once again
    } else if tag == ACCEPT || tag == RETRY {
      if tag == ACCEPT { admit(q, clients, i32(result)); }
      q.accept(server.fd, ACCEPT);
    } else {
      let k = usize(tag - 1);
      if result <= 0 {
        hang_up(clients, k); // the client closed its end, or its socket failed
      } else {
        let stop = try take_in(clients[k], t, usize(result), data[0..usize(result)]);
        if stop { running = false; } else { q.recv(clients[k].fd, data, LIMIT, tag); }
      }
    }
  }
  q.cancel(ACCEPT);
  q.cancel(RETRY);
  for k in 0..CLIENTS {
    if clients[k].live {
      q.cancel(u64(k) + 1);
      hang_up(clients, k);
    }
  }
  return Ok(0);
}

fn main() -> i32 {
  match run() {
    Ok(code) => return i32(code);
    Err(e) => {
      io.print("service: io error ");
      io.print_u64(u64(e.code));
      io.newline();
      return 1;
    }
  }
}
