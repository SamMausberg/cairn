// The self-check: fill a log, reopen it, survive two kinds of damaged tail, compact, reopen.
import std.core (Result);
import std.io (IoError);
import std.sys;
import std.text;
import std.vec (Vec);

// A path no other process in this test run shares. There is no argv, so the pid is the handle.
fn temp_path(n:usize, tail:ro<u8>[n]) -> Vec[u8] {
  let mut p = vec.new[u8]();
  p.extend_from("/tmp/cairn-kvstore-");
  unsafe { text.push_u64(p, u64(sys.getpid())); }
  p.extend_from(n, tail);
  p.push(0); // C reads a pointer, so the terminator lives in the storage
  return p;
}

fn value_is(s:ro<Store>, slot:usize, m:usize, want:ro<u8>[m]) -> bool {
  let have = s.index.vals[slot].value.len;
  return text.equal(s.index.vals[slot].value.data[0..have], want);
}

// Ok(0) is success; Ok(k) names the check that failed.
fn scenario() -> Result[usize, IoError] {
  let mut log = temp_path(".log");
  let mut tmp = temp_path(".tmp");
  let n = log.len;
  let m = tmp.len;
  let cleared = io.remove(log.data[0..n]); // it may not exist; that is not an error here

  { // fill: three puts and one delete, each one record on disk
    let f = try io.open(log.data[0..n], io.APPEND);
    defer io.close(f);
    let mut s = new_store();
    let start = try replay(s, f);
    if start != 0 { return Ok(1); }
    let a = try put(s, f, "alpha", "1");
    let b = try put(s, f, "beta", "22");
    let c = try put(s, f, "gamma", "333");
    let d = try erase(s, f, "beta");
    if s.index.count() != 2 { return Ok(2); }
  }

  { // reopen: the index comes back from the log, then a crash tears the next record
    let f = try io.open(log.data[0..n], io.APPEND);
    defer io.close(f);
    let mut s = new_store();
    let end = try replay(s, f);
    if s.index.count() != 2 { return Ok(3); }
    match get(s, "gamma") {
      Some(slot) => { if !value_is(s, slot, "333") { return Ok(4); } }
      None => { return Ok(5); }
    }
    match get(s, "beta") {
      Some(slot) => { return Ok(6); }
      None => {}
    }
    let torn = try io.write(f, "\x01\x02\x03\x04\x05\x06\x07\x08\x09");
  }

  { // the torn header is ignored and cut away; now a whole record with a wrong checksum
    let f = try io.open(log.data[0..n], io.APPEND);
    defer io.close(f);
    let mut s = new_store();
    let end = try replay(s, f);
    if s.index.count() != 2 { return Ok(7); }
    let size = try io.size(f);
    if size != end { return Ok(8); }
    stack bad:u8[16] = zeroed;
    encode_Header(bad, Header(12345, 0, 1, 1));
    let header = try io.write(f, bad);
    let payload = try io.write(f, "xy");
  }

  { // the corrupt record is ignored and cut away, and compaction rewrites the live records
    let f = try io.open(log.data[0..n], io.APPEND);
    defer io.close(f);
    let mut s = new_store();
    let end = try replay(s, f);
    if s.index.count() != 2 { return Ok(9); }
    let written = try compact_log(s, log.data[0..n], tmp.data[0..m]);
    if written == 0 || written >= end { return Ok(10); }
  }

  { // the compacted log holds exactly the live records
    let f = try io.open(log.data[0..n], io.APPEND);
    defer io.close(f);
    let mut s = new_store();
    let end = try replay(s, f);
    if s.index.count() != 2 { return Ok(11); }
    match get(s, "alpha") {
      Some(slot) => { if !value_is(s, slot, "1") { return Ok(12); } }
      None => { return Ok(13); }
    }
    match get(s, "beta") {
      Some(slot) => { return Ok(14); }
      None => {}
    }
    let after = try put(s, f, "new", "4444");
    if s.index.count() != 3 { return Ok(15); }
  }

  let gone = try io.remove(log.data[0..n]);
  return Ok(0);
}

fn main() -> i32 {
  match scenario() {
    Ok(step) => {
      if step == 0 {
        io.println("kvstore: self-check passed");
        return 0;
      }
      io.print("kvstore: failed check ");
      io.print_u64(u64(step));
      io.newline();
      return i32(step);
    }
    Err(e) => {
      io.print("kvstore: io error ");
      io.print_u64(u64(e.code));
      io.newline();
      return 100;
    }
  }
}
