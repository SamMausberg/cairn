// Running totals as a GPU computes them: blocks of 256 threads scan in shared memory, then the block offsets are added.
import std.core (Option, Result);
import std.io as io;
import std.text as text;
import std.vec (Vec);

struct Input { bytes:Vec[u8]; at:usize; }
struct Span { lo:usize; hi:usize; }

// All of standard input.
fn read_input() -> Input {
  let mut bytes = vec.new[u8]();
  stack chunk:u8[4096] = zeroed;
  let mut more = true;
  while more {
    match io.read_stdin(4096, chunk) {
      Ok(got) => {
        if got == 0 { more = false; } else { vec.extend_from(bytes, got, chunk[0..got]); }
      }
      Err(_) => more = false;
    }
  }
  return Input(bytes, 0);
}

// The next run of bytes that are not spaces, tabs or line ends, or None at the end of the input.
fn next_token(inp:rw<Input>) -> Option[Span] {
  let n = inp.bytes.len;
  let mut lo = inp.at;
  while lo < n && inp.bytes.data[lo] <= 32 { lo += 1; }
  if lo >= n { return None; }
  let mut hi = lo;
  while hi < n && inp.bytes.data[hi] > 32 { hi += 1; }
  inp.at = hi;
  return Some(Span(lo, hi));
}

// The next token as an unsigned integer; the input is well formed, so anything else is a guard failure.
fn next_u64(inp:rw<Input>) -> u64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_u64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an unsigned integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

// Each block of 256 threads scans its 256 values in shared memory, in eight steps with a barrier on either side
// of every read of another thread's element; thread 0 keeps the block's total.
fn scan_blocks(n:usize, x:ro<u64>[n]@device, out:rw<u64>[n]@device, g:usize, totals:rw<u64>[g]@device) {
  blocks b in g threads t in 256 {
    shared s:u64[256] = zeroed;
    let i = b * 256 + t;
    if i < n { s[t] = x[i]; }
    barrier;
    for k in 0..8 {
      let d:usize = shl_wrap(1, k);
      let mut v:u64 = 0;
      if t >= d { v = s[t - d]; }
      barrier;                                     // every thread has read before any writes
      s[t] = s[t] + v;
      barrier;                                     // every thread has written before the next step reads
    }
    if i < n { out[i] = s[t]; }
    if t == 0 { totals[b] = s[255]; }
  }
}

// Adds to every element the totals of all earlier blocks.
fn add_offsets(n:usize, out:rw<u64>[n]@device, g:usize, offsets:ro<u64>[g]@device) {
  parallel i in n { out[i] = out[i] + offsets[i / 256]; }
}

fn main() -> i32 {
  let mut inp = read_input();
  let count = next_u64(inp);
  let n = usize(count);
  let g = (n + 255) / 256;
  buffer values:u64[n] = zeroed;
  for i in 0..n {
    let v = next_u64(inp);
    values[i] = v;
  }
  buffer x:u64[n]@device = zeroed;
  buffer out:u64[n]@device = zeroed;
  buffer totals:u64[g]@device = zeroed;
  transfer(x, values);
  scan_blocks(n, x, out, g, totals);
  buffer sums:u64[g] = zeroed;
  transfer(sums, totals);
  buffer before:u64[g] = zeroed;
  scan + exclusive before for b in g yield sums[b];
  buffer offsets:u64[g]@device = zeroed;
  transfer(offsets, before);
  add_offsets(n, out, g, offsets);
  buffer result:u64[n] = zeroed;
  transfer(result, out);
  for i in 0..n { println(result[i]); }
  return 0;
}
