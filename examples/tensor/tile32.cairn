// c += a * b with mma.sync fragments, a tiling of its own: 64 x 32 output tiles, one block
// of eight warps each, every warp two 16 x 8 fragments side by side, k in steps of 32 through one
// shared stage whose a is swizzled, which the ldmatrix loads of mma.sync read.
layout A_TILE = swizzle(rows(64, 32), 2, 3, 3); // each row's four 16-byte runs permuted
layout B_TILE = pad(rows(32, 32), 8); // 32 x 32 halves, rows 40 halves apart
layout C_TILE = rows(64, 32); // the tile's outputs
layout A_COPY = spread(rows(64, 32), 64, 4, 1, 8); // 256 threads, 8 halves (16 bytes) a run
layout B_COPY = spread(rows(32, 32), 32, 8, 1, 4); // 256 threads, 8-byte runs
layout WARPS = spread(rows(4, 4), 4, 2, 1, 2); // warp (r, c) holds (r, 2c), (r, 2c + 1)
const A_CELLS:usize = A_TILE.cosize();
const B_CELLS:usize = B_TILE.cosize();
const C_CELLS:usize = C_TILE.cosize();

fn tile32(
  m:usize, n:usize, k:usize, cn:usize, c:rw<f32>[cn]@device, an:usize, a:ro<bf16>[an]@device,
  bn:usize, b:ro<bf16>[bn]@device
) {
  let across = (n + 31) / 32;
  let down = (m + 63) / 64;
  let steps = (k + 31) / 32;
  blocks bx, by in across, down threads tx, ty in 32, 8 {
    shared sa:bf16[A_CELLS] = zeroed;
    shared sb:bf16[B_CELLS] = zeroed;
    shared sc:f32[C_CELLS] = zeroed;
    let t = tx + 32 * ty;
    for i in 0..8 { // the tile's old outputs; past the matrix they stay 0
      if by * 64 + ty + 8 * i < m && bx * 32 + tx < n {
        sc[C_TILE.at(ty + 8 * i, tx)] = c[(by * 64 + ty + 8 * i) * n + bx * 32 + tx];
      }
    }
    barrier;
    let mut acc0 = mma_load[MmaAcc[f32, 16, 8, 16]](sc, C_TILE, WARPS.row(ty, 0), WARPS.col(ty, 0));
    let mut acc1 = mma_load[MmaAcc[f32, 16, 8, 16]](sc, C_TILE, WARPS.row(ty, 1), WARPS.col(ty, 1));
    for step in 0..steps {
      for v in 0..A_COPY.values() { // this step's slice of a and b, zero past the matrix
        let r = A_COPY.row(t, v);
        let q = A_COPY.col(t, v);
        if by * 64 + r < m && step * 32 + q < k {
          sa[A_TILE.at(r, q)] = a[(by * 64 + r) * k + step * 32 + q];
        } else { sa[A_TILE.at(r, q)] = bf16(0.0); }
      }
      for v in 0..B_COPY.values() {
        let p = B_COPY.row(t, v);
        let q = B_COPY.col(t, v);
        if step * 32 + p < k && bx * 32 + q < n {
          sb[B_TILE.at(p, q)] = b[(step * 32 + p) * n + bx * 32 + q];
        } else { sb[B_TILE.at(p, q)] = bf16(0.0); }
      }
      barrier;
      for h in 0..2 { // two 16-deep slices of the 32-deep step
        let x = mma_load[MmaA[bf16, 16, 8, 16]](sa, A_TILE, WARPS.row(ty, 0), h);
        let y0 = mma_load[MmaB[bf16, 16, 8, 16]](sb, B_TILE, h, WARPS.col(ty, 0));
        let y1 = mma_load[MmaB[bf16, 16, 8, 16]](sb, B_TILE, h, WARPS.col(ty, 1));
        acc0 = mma_unordered(acc0, x, y0);
        acc1 = mma_unordered(acc1, x, y1);
      }
      barrier; // every warp has read the step before the next is written
    }
    barrier; // with no step at all, the loads above are still read
    mma_store(sc, C_TILE, WARPS.row(ty, 0), WARPS.col(ty, 0), acc0);
    mma_store(sc, C_TILE, WARPS.row(ty, 1), WARPS.col(ty, 1), acc1);
    barrier;
    for i in 0..8 { // the tile's outputs back, only inside the matrix
      if by * 64 + ty + 8 * i < m && bx * 32 + tx < n {
        c[(by * 64 + ty + 8 * i) * n + bx * 32 + tx] = sc[C_TILE.at(ty + 8 * i, tx)];
      }
    }
  }
}
