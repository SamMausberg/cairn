// The keyed state behind the protocol: a hash map from the 64-bit digest of a key to the key
// and value bytes. The stored key is compared on every hit, so a digest collision is a miss
// rather than a wrong answer.
import std.core (Option);
import std.map (Map);
import std.text;
import std.vec (Vec);

struct Entry { key:Vec[u8]; value:Vec[u8]; }
struct Table { index:Map[u64, Entry]; }

fn new_table() -> Table {
  let index = map.new[u64, Entry]();
  return Table(index);
}

fn owned(n:usize, data:ro<u8>[n]) -> Vec[u8] {
  let mut copy = vec.with_capacity[u8](n);
  copy.extend_from(n, data);
  return copy;
}

fn put(t:rw<Table>, k:usize, key:ro<u8>[k], v:usize, value:ro<u8>[v]) {
  let id = text.hash_bytes(k, key);
  let stored_key = owned(k, key);
  let stored_value = owned(v, value);
  t.index.insert(id, Entry(stored_key, stored_value));
}

fn find(t:ro<Table>, k:usize, key:ro<u8>[k]) -> Option[usize] {
  let id = text.hash_bytes(k, key);
  match t.index.find(id) {
    Option.Some(slot) => {
      let stored = t.index.vals[slot].key.len;
      if text.equal(stored, t.index.vals[slot].key.data[0..stored], k, key) { return Option.Some(slot); }
      return Option.None;
    }
    Option.None => { return Option.None; }
  }
}

fn erase(t:rw<Table>, k:usize, key:ro<u8>[k]) -> bool {
  match find(t, k, key) {
    Option.Some(slot) => {
      let id = text.hash_bytes(k, key);
      let gone = t.index.remove(id);
      return true;
    }
    Option.None => { return false; }
  }
}
