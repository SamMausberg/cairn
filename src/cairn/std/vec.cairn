// A growable owner. Growth is the only allocation and it is visible in every caller's effect row.
module std.vec;
import std.core (Option, Eq);
import std.mem;

// Lent where a view is expected: `io.print(line)` passes the elements it holds, `line.data[0..line.len]`.
pub struct Vec[T:affine] { data:Buf[T]; len:usize; lends data[0..len]; }

pub fn new[T:affine]() -> Vec[T] = Vec(Buf[T](0), 0);
pub fn with_capacity[T:affine](capacity:usize) -> Vec[T] = Vec(Buf[T](capacity), 0);
pub fn capacity[T:affine](v:ro<Vec[T]>) -> usize = len(v.data);

// Doubling keeps pushes amortized constant; elements move by swap, so owners are never copied.
// Cost: one allocation, and one pass over the elements held with no guard in it.
pub fn reserve[T:affine](v:rw<Vec[T]>, wanted:usize) {
  if wanted <= len(v.data) { return; }
  let mut bigger = Buf[T](max(wanted, max(4, len(v.data) * 2)));
  exchange(v.len, bigger[0..v.len], v.data[0..v.len]);
  v.data = bigger;
}

// Over two views of one extent no index needs a guard, so the loop is a bulk exchange.
fn exchange[T:affine](n:usize, a:rw<T>[n], b:rw<T>[n]) { for i in 0..n { swap(a[i], b[i]); } }

pub fn push[T:affine](v:rw<Vec[T]>, item:T) {
  reserve(v, v.len + 1);
  v.data[v.len] = item;
  v.len += 1;
}

pub fn pop[T:affine](v:rw<Vec[T]>) -> Option[T] {
  if v.len == 0 { return None; }
  v.len -= 1;
  return Some(take(v.data[v.len]));
}

// Put `item` at `i` and move the tail up by one; an index past the end is a guard failure.
pub fn insert[T:affine](v:rw<Vec[T]>, i:usize, item:T) {
  if i > v.len { v.data[len(v.data)] = item; return; }
  reserve(v, v.len + 1);
  let mut at = v.len;
  while at > i {
    swap(v.data[at], v.data[at - 1]);
    at -= 1;
  }
  v.data[i] = item;
  v.len += 1;
}

// Take the element at `i` out and close the gap, keeping the order of the rest.
pub fn remove[T:affine](v:rw<Vec[T]>, i:usize) -> Option[T] {
  if i >= v.len { return None; }
  let item = take(v.data[i]);
  for k in i..v.len - 1 { swap(v.data[k], v.data[k + 1]); }
  v.len -= 1;
  return Some(item);
}

// Take the element at `i` out and move the last one into its place: one swap, no shift.
pub fn swap_remove[T:affine](v:rw<Vec[T]>, i:usize) -> Option[T] {
  if i >= v.len { return None; }
  swap(v.data[i], v.data[v.len - 1]);
  return pop(v);
}

// The first index holding an element equal to `item`, by the element type's Eq.
pub fn find[T:Eq + affine](v:ro<Vec[T]>, item:ro<T>) -> Option[usize] {
  for i in 0..v.len { if same(v.data[i], item) { return Some(i); } }
  return None;
}

pub fn get[T:copy](v:ro<Vec[T]>, i:usize) -> T {
  if i >= v.len { return v.data[len(v.data)]; }
  return v.data[i];
}

pub fn set[T:affine](v:rw<Vec[T]>, i:usize, item:T) {
  if i >= v.len { v.data[len(v.data)] = item; return; }
  v.data[i] = item;
}

pub fn clear[T:affine](v:rw<Vec[T]>) {
  for i in 0..v.len { let dropped = take(v.data[i]); }
  v.len = 0;
}

// Append a view. Copying elements, so it instantiates only for copyable ones; an owner would
// have to be moved out of the source view, which no borrow allows.
// Cost: amortized one pass over `src`, one guard for the part it lands in.
pub fn extend_from[T:copy](v:rw<Vec[T]>, n:usize, src:ro<T>[n]) {
  let wanted = v.len + n;
  reserve(v, wanted);
  mem.copy(n, v.data[v.len..wanted], src);
  v.len = wanted;
}

// Release the tail now instead of at the owner's scope exit; capacity is kept.
pub fn truncate[T:affine](v:rw<Vec[T]>, count:usize) {
  if count >= v.len { return; }
  for i in count..v.len { take(v.data[i]); }
  v.len = count;
}
