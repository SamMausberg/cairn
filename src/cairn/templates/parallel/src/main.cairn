// Fills a million squares on every core, sums them, and prints how long it took.
import std.time;

fn main() -> i32 {
  let n:usize = 1000000;
  let mut xs = Buf[u64](n);
  let start = time.now();
  fill(xs);
  let sum = total(xs);
  let took = time.since(start);
  println("sum of the squares below a million: ", sum);
  println("filled and summed in ", took / 1000, " us");
  if sum != expected(u64(n)) { return 1; }
  return 0;
}
