// Sums k contiguous chunks on k tasks of one group, reporting every sum that leaves the i64 range.
import std.core (Option, Result);
import std.io as io;
import std.text as text;
import std.vec (Vec);

struct Input { bytes:Vec[u8]; at:usize; }
struct Span { lo:usize; hi:usize; }

// All of standard input.
fn read_input() -> Input {
  let mut bytes = vec.new[u8]();
  stack chunk:u8[4096] = zeroed;
  let mut more = true;
  while more {
    match io.read_stdin(4096, chunk) {
      Ok(got) => {
        if got == 0 { more = false; } else { vec.extend_from(bytes, got, chunk[0..got]); }
      }
      Err(_) => more = false;
    }
  }
  return Input(bytes, 0);
}

// The next run of bytes that are not spaces, tabs or line ends, or None at the end of the input.
fn next_token(inp:rw<Input>) -> Option[Span] {
  let n = inp.bytes.len;
  let mut lo = inp.at;
  while lo < n && inp.bytes.data[lo] <= 32 { lo += 1; }
  if lo >= n { return None; }
  let mut hi = lo;
  while hi < n && inp.bytes.data[hi] > 32 { hi += 1; }
  inp.at = hi;
  return Some(Span(lo, hi));
}

// The next token as an unsigned integer; the input is well formed, so anything else is a guard failure.
fn next_u64(inp:rw<Input>) -> u64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_u64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an unsigned integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

// The next token as a signed integer.
fn next_i64(inp:rw<Input>) -> i64 {
  match next_token(inp) {
    Some(s) => {
      match text.parse_i64(s.hi - s.lo, inp.bytes.data[s.lo..s.hi]) {
        Ok(v) => return v;
        Err(_) => { assert(false, "expected an integer"); return 0; }
      }
    }
    None => { assert(false, "input ended early"); return 0; }
  }
}

const MAX:i64 = 9223372036854775807;

struct Sum { j:usize; value:i64; over:bool; }

// Whether a + b falls outside the i64 range; the lower bound -MAX - 1 - b is written so that it cannot overflow.
fn overflows(a:i64, b:i64) -> bool = (b > 0 && a > MAX - b) || (b < 0 && a < 0 - (MAX + (b + 1)));

// Chunk j, xs[lo..hi], added from 0 left to right; `over` when a partial sum leaves the i64 range.
fn chunk_sum(n:usize, xs:ro<i64>[n], lo:usize, hi:usize, j:usize) -> Sum {
  let mut total:i64 = 0;
  for i in lo..hi {
    if overflows(total, xs[i]) { return Sum(j, 0, true); }
    total += xs[i];
  }
  return Sum(j, total, false);
}

fn main() -> i32 {
  let mut inp = read_input();
  let k_in = next_u64(inp);
  let n_in = next_u64(inp);
  let k = usize(k_in);
  let n = usize(n_in);
  let mut values = Buf[i64](n);
  for i in 0..n {
    let v = next_i64(inp);
    values[i] = v;
  }
  let sums = Group[Sum](k);
  for j in 0..k { spawn chunk_sum(values, j * n / k, (j + 1) * n / k, j) into sums; }
  let mut value = Buf[i64](k);
  let mut over = Buf[bool](k);
  for _ in 0..k {
    let s = collect(sums);
    value[s.j] = s.value;
    over[s.j] = s.over;
  }
  wait(sums);
  let mut broken = false;
  let mut total:i64 = 0;
  for j in 0..k {
    if over[j] {
      println("chunk ", j, " overflow");
      broken = true;
    } else {
      println("chunk ", j, " ", value[j]);
      if !broken {
        if overflows(total, value[j]) { broken = true; } else { total += value[j]; }
      }
    }
  }
  if broken { println("total overflow"); } else { println("total ", total); }
  return 0;
}
