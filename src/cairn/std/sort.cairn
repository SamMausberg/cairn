// In-place ordering. Heapsort, because it is the one O(n log n) algorithm that needs no
// recursion (no `diverge` in the effect row), no scratch buffer (no `alloc`) and moves
// elements only with `swap`, so it sorts owners as happily as scalars.
// Cost: O(n log n) comparisons and swaps, no allocation; the order of equal elements is not kept.
module std.sort;
import std.core (Option, Ord);

// Restore the heap property below `start` within the prefix of length `count`.
fn sift[T](n:usize, xs:rw<T>[n], start:usize, count:usize, less:ro<fn(ro<T>, ro<T>) -> bool>) {
  let mut root = start;
  while root * 2 + 1 < count {
    let mut child = root * 2 + 1;
    if child + 1 < count && less(xs[child], xs[child + 1]) { child += 1; }
    if !less(xs[root], xs[child]) { return; }
    swap(xs[root], xs[child]);
    root = child;
  }
}

pub fn sort_by[T](n:usize, xs:rw<T>[n], less:ro<fn(ro<T>, ro<T>) -> bool>) {
  if n < 2 { return; }
  let mut i = n / 2;
  while i > 0 {
    i -= 1;
    sift(n, xs, i, n, less);
  }
  let mut end = n;
  while end > 1 {
    end -= 1;
    swap(xs[0], xs[end]);
    sift(n, xs, 0, end, less);
  }
}

pub fn sort[T:Ord](n:usize, xs:rw<T>[n]) {
  sort_by(n, xs, |a:ro<T>, b:ro<T>| -> bool { return less(a, b); });
}

// Stable sort of unsigned keys, eight bits a pass, least significant first. Passes come in pairs, xs to
// scratch and back, and stop once the largest key has no digit left, so small keys pay for their width only.
// Cost: O(n) per pass, at most eight passes, no allocation: the caller lends scratch of the same extent.
pub fn radix_sort[T:unsigned](n:usize, xs:rw<T>[n], scratch:rw<T>[n]) {
  let top = reduce max for i in n yield xs[i];
  for pair in 0..4 { // digits at 0 and 8, 16 and 24, 32 and 40, 48 and 56
    if shr(u64(top), pair * 16) == 0 { return; }
    radix_pass(xs, scratch, pair * 16);
    radix_pass(scratch, xs, pair * 16 + 8);
  }
}

// One pass: count each key's digit, make each digit's first place with an exclusive scan, move the keys there.
fn radix_pass[T:unsigned](n:usize, from:ro<T>[n], to:rw<T>[n], shift:usize) {
  stack counts:usize[256] = zeroed;
  stack starts:usize[256] = zeroed;
  for x in from { counts[usize(shr(u64(x), shift) & 255)] += 1; }
  scan + exclusive starts for d in 256 yield counts[d];
  for x in from {
    let d = usize(shr(u64(x), shift) & 255);
    to[starts[d]] = x;
    starts[d] += 1;
  }
}

// The index of a value equal to `key` in an already sorted view, if one is there.
pub fn search[T:Ord](n:usize, xs:ro<T>[n], key:ro<T>) -> Option[usize] {
  let mut lo:usize = 0;
  let mut hi = n;
  while lo < hi {
    let mid = lo + (hi - lo) / 2;
    if less(xs[mid], key) { lo = mid + 1; } else { hi = mid; }
  }
  if lo < n && !less(key, xs[lo]) { return Some(lo); }
  return None;
}
