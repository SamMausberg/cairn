// upload -> map -> compact -> reduce -> download, with the same four stages written for the
// host so the answers can be compared. Each stage is one statement; the placement of the views
// is the only thing that decides where it runs.
import std.io;

// A cheap invertible mix, pure so that both a host lane and a device lane may call it.
fn mix(x:u64) -> u64 = mul_wrap(x ^ 2654435769, 6364136223846793005);

fn map_host(m:usize, out:rw<u64>[m], src:ro<u64>[m]) {
  for i in 0..m { out[i] = mix(src[i]); }
}

fn map_device(m:usize, out:rw<u64>[m]@device, src:ro<u64>[m]@device) {
  parallel i in m { out[i] = mix(src[i]); }
}

// Stable stream compaction: the selected values keep their input order in both back ends.
fn keep_host(m:usize, out:rw<u64>[m], src:ro<u64>[m]) -> usize {
  let used = compact out for i in m where (src[i] & 7) == 0 yield src[i];
  return used;
}

fn keep_device(m:usize, out:rw<u64>[m]@device, src:ro<u64>[m]@device) -> usize {
  let used = compact out for i in m where (src[i] & 7) == 0 yield src[i];
  return used;
}

// add_wrap, not +: the device folds in an unspecified order, and only a wrapping operator is
// exact under any association. Checked + is not offered here for exactly that reason.
fn sum_host(m:usize, src:ro<u64>[m]) -> u64 {
  let total = reduce add_wrap for i in m yield src[i];
  return total;
}

fn sum_device(m:usize, src:ro<u64>[m]@device) -> u64 {
  let total = reduce add_wrap for i in m yield src[i];
  return total;
}

fn report(n:usize, label:ro<u8>[n], nanoseconds:u64) {
  io.print(n, label);
  io.print_u64(nanoseconds / 1000);
  let unit = " us";
  io.println(len(unit), unit);
}
