struct Reading { a:u32; b:u32; c:u16; }

recipe zero_fields for R {
    fn count_zero_$R(v:R) -> usize {
        let mut n:usize = 0;
        each f in R {
            require unsigned(f), "zero_fields needs unsigned integer fields";
            if v.$f == 0 {
                n = n + 1;
            }
        }
        return n;
    }
}

derive zero_fields for Reading;

fn zeros(a:u32, b:u32, c:u16) -> usize {
    return count_zero_Reading(Reading(a, b, c));
}
