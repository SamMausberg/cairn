// Prints the ten most frequent words of standard input as `word count`, most frequent first, ties by word ascending.
// A word is a maximal run of ASCII letters, lower-cased. Counts are kept in a hash map keyed by the word's bytes.
import std.core (Option, Result, Hash, Eq);
import std.io as io;
import std.text as text;
import std.sort as sort;
import std.map (Map);
import std.vec (Vec);

struct Word { bytes:Vec[u8]; }
struct Entry { count:u64; slot:usize; }

impl Hash for Word {
  fn hash(value:ro<Word>) -> u64 pure { return text.hash_bytes(value.bytes); }
}
impl Eq for Word {
  fn same(a:ro<Word>, b:ro<Word>) -> bool pure { return text.equal(a.bytes, b.bytes); }
}

fn is_letter(c:u8) -> bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

fn main() -> i32 {
  let mut input = vec.new[u8]();
  stack chunk:u8[4096] = zeroed;
  let mut more = true;
  while more {
    match io.read_stdin(4096, chunk) {
      Ok(got) => {
        if got == 0 { more = false; } else { vec.extend_from(input, got, chunk[0..got]); }
      }
      Err(e) => { eprintln("cannot read standard input: errno ", e.code); return 1; }
    }
  }
  let n = input.len;
  let mut counts = map.new[Word, u64]();
  let scratch = vec.new[u8]();
  let mut key = Word(scratch);
  let mut i:usize = 0;
  while i < n {
    if is_letter(input.data[i]) {
      let lo = i;
      while i < n && is_letter(input.data[i]) {
        if input.data[i] <= 'Z' { input.data[i] = input.data[i] + 32; }
        i += 1;
      }
      vec.clear(key.bytes);
      vec.extend_from(key.bytes, i - lo, input.data[lo..i]);
      match map.find(counts, key) {
        Some(slot) => counts.vals[slot] += 1;
        None => {
          let mut fresh = vec.new[u8]();
          vec.extend_from(fresh, i - lo, input.data[lo..i]);
          map.insert(counts, Word(fresh), 1);
        }
      }
    } else {
      i += 1;
    }
  }
  let mut entries = vec.new[Entry]();
  let mut s:usize = 0;
  while s < map.slots(counts) {
    if map.live(counts, s) { vec.push(entries, Entry(counts.vals[s], s)); }
    s += 1;
  }
  let e = entries.len;
  sort.sort_by(e, entries.data[0..e], |a:ro<Entry>, b:ro<Entry>| -> bool {
    if a.count != b.count { return a.count > b.count; }
    return text.compare(counts.keys[a.slot].bytes, counts.keys[b.slot].bytes) < 0;
  });
  let mut t:usize = 0;
  while t < e && t < 10 {
    println(counts.keys[entries.data[t].slot].bytes, ' ', entries.data[t].count);
    t += 1;
  }
  return 0;
}
