// Executable CAIRN Native 0.2. Arrays are borrowed, not allocated or copied.
struct Vec3 { x:f64; y:f64; z:f64; }
struct Header { version:u32; flags:u32; length:u64; }
enum Op { ping; data; close; }

fn saxpy(n:usize, out:rw<f32>[n], x:ro<f32>[n], y:ro<f32>[n], a:f32) {
  each i in n { out[i] = a * x[i] + y[i]; }
}

fn dot(n:usize, x:ro<f64>[n], y:ro<f64>[n]) -> f64 {
  reg total:f64 = 0.0;
  each i in n { total = total + x[i] * y[i]; }
  return total;
}

fn sum_wrap(n:usize, x:ro<u64>[n]) -> u64 {
  reg total:u64 = 0;
  each i in n { total = add_wrap(total, x[i]); }
  return total;
}

fn prefix(n:usize, out:rw<u64>[n], x:ro<u64>[n]) {
  reg total:u64 = 0;
  each i in n { total = add_wrap(total, x[i]); out[i] = total; }
}

fn count_gt(n:usize, x:ro<f32>[n], threshold:f32) -> usize {
  reg count:usize = 0;
  each i in n { if x[i] > threshold { count = add_wrap(count, 1); } }
  return count;
}

fn histogram(n:usize, out:rw<u64>[256], x:ro<u8>[n]) {
  each b in 256 { out[b] = 0; }
  each i in n { let b = usize(x[i]); out[b] = add_wrap(out[b], 1); }
}

fn compact_even(n:usize, out:rw<u64>[n], x:ro<u64>[n]) -> usize {
  let used = compact out for i in n where (x[i] & 1) == 0 yield x[i];
  return used;
}

fn lower_bound(n:usize, x:ro<u64>[n], key:u64) -> usize {
  reg lo:usize = 0;
  reg hi = n;
  while lo < hi {
    let mid = lo + (hi - lo) / 2;
    if x[mid] < key { lo = mid + 1; } else { hi = mid; }
  }
  return lo;
}

fn gcd(a:u64, b:u64) -> u64 {
  reg x = a;
  reg y = b;
  while y != 0 { let t = x % y; x = y; y = t; }
  return x;
}

fn factorial_wrap(n:u64) -> u64 {
  if n == 0 { return 1; }
  return mul_wrap(n, factorial_wrap(sub_wrap(n, 1)));
}

fn distance_sq(a:Vec3, b:Vec3) -> f64 {
  let x = a.x - b.x;
  let y = a.y - b.y;
  let z = a.z - b.z;
  return x * x + y * y + z * z;
}

fn translated(p:Vec3, delta:Vec3) -> Vec3 {
  reg q = p;
  q.x = q.x + delta.x;
  q.y = q.y + delta.y;
  q.z = q.z + delta.z;
  return q;
}

fn header_valid(h:Header, available:u64) -> bool = h.version == 1 && h.length <= available
  && (h.flags & 4294967292) == 0;

fn op_class(op:Op) -> u32 {
  if op == Op.ping { return 10; }
  if op == Op.data { return 20; }
  return 30;
}

fn decode_le32(n:usize, bytes:ro<u8>[n], offset:usize) -> u32 {
  return u32(bytes[offset]) | shl_wrap(u32(bytes[offset + 1]), 8)
    | shl_wrap(u32(bytes[offset + 2]), 16) | shl_wrap(u32(bytes[offset + 3]), 24);
}

fn copy_twice(n:usize, out:rw<f32>[n], x:ro<f32>[n]) {
  each i in n { out[i] = x[i] * 2.0; }
}

fn delegated(n:usize, out:rw<f32>[n], x:ro<f32>[n]) {
  copy_twice(n, out, x);
}

fn checked_add(a:u64, b:u64) -> u64 = a + b;
fn checked_div(a:i64, b:i64) -> i64 = a / b;
fn checked_at(n:usize, a:ro<u64>[n], i:usize) -> u64 = a[i];
fn checked_shift(a:u32, b:usize) -> u32 = shl_wrap(a, b);
fn narrow(a:u64) -> u8 = u8(a);

// Same borrowed input can safely be passed to two read-only formals.
fn square_sum(n:usize, x:ro<f64>[n]) -> f64 = dot(n, x, x);
