// The program's arguments and environment, as it was started. Linux keeps both under /proc/self exactly
// as the kernel passed them, so reading them needs no start-up code and works from any module.
// Cost: each call reads one small file into a Vec it returns; a program reads its arguments once.
module std.env;
import std.core (Option, Result);
import std.fs;
import std.io (IoError);
import std.text;
import std.vec (Vec);

// Every argument, the program's own path first, in `text` with the NUL each ends in. Argument i is
// text[begin(a, i)..end(a, i)], and text[end(a, i)] is its NUL, for a call into C that wants one.
pub struct Args { text:Vec[u8]; ends:Vec[usize]; }

pub fn args() -> Result[Args, IoError] {
  let raw = try fs.read("/proc/self/cmdline");
  let mut ends = vec.new[usize]();
  for i, b in raw { if b == 0 { ends.push(i); } }
  return Ok(Args(raw, ends));
}

pub fn count(a:ro<Args>) -> usize = a.ends.len;

// Where argument i starts and ends in a.text; an i past the last argument is a guard failure.
pub fn begin(a:ro<Args>, i:usize) -> usize {
  vec.get(a.ends, i); // the guard, for the argument asked for
  if i == 0 { return 0; }
  return a.ends.data[i - 1] + 1;
}
pub fn end(a:ro<Args>, i:usize) -> usize = vec.get(a.ends, i);

// The value of the variable called `name` when the program started, or None.
pub fn var(n:usize, name:ro<u8>[n]) -> Result[Option[Vec[u8]], IoError] {
  let raw = try fs.read("/proc/self/environ");
  let mut start:usize = 0;
  for i, b in raw {
    if b == 0 {
      let at = start + n; // `name=` then the value, up to this NUL
      if at < i && raw.data[at] == '=' && text.equal(raw.data[start..at], name) {
        let mut value = vec.with_capacity[u8](i - at - 1);
        value.extend_from(raw.data[at + 1..i]);
        return Ok(Some(value));
      }
      start = i + 1;
    }
  }
  return Ok(None);
}
