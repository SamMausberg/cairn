// Prints field k of every row of a comma-separated file.
import std.core (Option, Result);
import std.io as io;
import std.text as text;
import std.vec (Vec);

// All of standard input.
fn read_input() -> Vec[u8] {
  let mut bytes = vec.new[u8]();
  stack chunk:u8[4096] = zeroed;
  let mut more = true;
  while more {
    match io.read_stdin(4096, chunk) {
      Ok(got) => {
        if got == 0 { more = false; } else { vec.extend_from(bytes, got, chunk[0..got]); }
      }
      Err(_) => more = false;
    }
  }
  return bytes;
}

// Prints field k of the row text[lo..hi], where hi is the row's newline or the end of the input.
fn print_field(n:usize, text:ro<u8>[n], lo:usize, hi:usize, k:usize) {
  let mut start = lo;
  for _ in 0..k {
    while start < hi && text[start] != ',' { start += 1; }
    if start == hi {
      println("none");
      return;
    }
    start += 1; // past the comma
  }
  let mut end = start;
  while end < hi && text[end] != ',' { end += 1; }
  println(text[start..end]);
}

fn main() -> i32 {
  let input = read_input();
  let n = input.len;
  let mut pos:usize = 0;
  while pos < n && input.data[pos] != 10 { pos += 1; }
  let mut k:usize = 0;
  match text.parse_u64(pos, input.data[0..pos]) {
    Ok(v) => k = usize(v);
    Err(_) => return 2;
  }
  pos += 1; // past the first line's newline
  while pos < n {
    let mut hi = pos;
    while hi < n && input.data[hi] != 10 { hi += 1; }
    print_field(input, pos, hi, k);
    pos = hi + 1;
  }
  return 0;
}
