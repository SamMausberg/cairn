// Blocking TCP over the C library. A Socket is linear, so a descriptor cannot be dropped by
// forgetting it; the failure paths below close the raw descriptor *before* a Socket exists,
// which is why they still read errno first - close() would overwrite it.
// Cost: one syscall per call except `send`, which loops until the whole view is gone. There is
// no polling, no timeout and no concurrency here: one connection is served at a time.
module std.net;
import std.core (Result);
import std.io (IoError);
import std.sys;

pub linear struct Socket { fd:i32; }

// struct sockaddr_in, written byte by byte: AF_INET in host order, port and address in network
// order. Writing the bytes is shorter than binding htons and dodges every alignment question.
fn address(addr:rw<u8>[16], ip:ro<u8>[4], port:u16) {
  addr[0] = 2;
  addr[2] = u8(shr(port, 8));
  addr[3] = u8(port & 255);
  for i in 0..4 { addr[4 + i] = ip[i]; }
}

fn error[T]() -> Result[T, IoError] = Result.Err(IoError(sys.errno()));

fn abandon[T](fd:i32) -> Result[T, IoError] {
  let code = sys.errno();
  unsafe { let closed = sys.close(fd); }
  return Result.Err(IoError(code));
}

pub fn listen_on(ip:ro<u8>[4], port:u16, backlog:i32) -> Result[Socket, IoError] {
  buffer addr:u8[16] = zeroed;
  address(addr, ip, port);
  unsafe {
    let fd = sys.socket(2, 1, 0);
    if fd < 0 { return error(); }
    // SO_REUSEADDR: a restart must not lose to the previous listener's TIME_WAIT.
    let reused = sys.setsockopt(fd, 1, 2, "\x01\x00\x00\x00", 4);
    if sys.bind(fd, addr, 16) < 0 { return abandon(fd); }
    if sys.listen(fd, backlog) < 0 { return abandon(fd); }
    return Result.Ok(Socket(fd));
  }
}

pub fn accept(s:ro<Socket>) -> Result[Socket, IoError] {
  buffer addr:u8[16] = zeroed;
  let mut length:u32 = 16;
  unsafe {
    let fd = sys.accept(s.fd, addr, length);
    if fd < 0 { return error(); }
    return Result.Ok(Socket(fd));
  }
}

pub fn connect_to(ip:ro<u8>[4], port:u16) -> Result[Socket, IoError] {
  buffer addr:u8[16] = zeroed;
  address(addr, ip, port);
  unsafe {
    let fd = sys.socket(2, 1, 0);
    if fd < 0 { return error(); }
    if sys.connect(fd, addr, 16) < 0 { return abandon(fd); }
    return Result.Ok(Socket(fd));
  }
}

pub fn send(s:ro<Socket>, n:usize, data:ro<u8>[n]) -> Result[usize, IoError] {
  let mut done:usize = 0;
  while done < n {
    unsafe {
      let sent = sys.send(s.fd, data[done..n], n - done, 0);
      if sent <= 0 { return error(); }
      done = done + usize(sent);
    }
  }
  return Result.Ok(done);
}

// One recv: a count of 0 means the peer closed its end, never an error.
pub fn recv(s:ro<Socket>, n:usize, into:rw<u8>[n]) -> Result[usize, IoError] {
  unsafe {
    let got = sys.recv(s.fd, into, n, 0);
    if got < 0 { return error(); }
    return Result.Ok(usize(got));
  }
}

pub fn close(s:Socket) { unsafe { let closed = sys.close(s.fd); } }
