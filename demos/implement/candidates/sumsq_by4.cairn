// The corrected attempt: four running sums, for a length four divides. The reference runs everywhere else.
fn sumsq_by4(n:usize, xs:ro<f64>[n]) -> f64 implements sumsq when n % 4 == 0 {
  let mut a = 0.0;
  let mut b = 0.0;
  let mut c = 0.0;
  let mut d = 0.0;
  for k in 0..n / 4 {
    a += xs[4 * k] * xs[4 * k];
    b += xs[4 * k + 1] * xs[4 * k + 1];
    c += xs[4 * k + 2] * xs[4 * k + 2];
    d += xs[4 * k + 3] * xs[4 * k + 3];
  }
  return (a + b) + (c + d);
}
