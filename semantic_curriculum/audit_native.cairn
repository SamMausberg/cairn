fn modular_increment_u8_reference(x:u8)->u8 {if x==255 {return 0;} return x+1;}

fn modular_increment_u8_chosen(x:u8)->u8 {return add_wrap(x,1);}

fn modular_increment_u8_rejected(x:u8)->u8 {return x+1;}

fn minimum_u8_reference(x:u8,y:u8)->u8 {if x<y {return x;} return y;}

fn minimum_u8_chosen(x:u8,y:u8)->u8 {return min(x,y);}

fn minimum_u8_rejected(x:u8,y:u8)->u8 {return max(x,y);}

fn maximum_u8_reference(x:u8,y:u8)->u8 {if x>y {return x;} return y;}

fn maximum_u8_chosen(x:u8,y:u8)->u8 {return max(x,y);}

fn maximum_u8_rejected(x:u8,y:u8)->u8 {return min(x,y);}

fn absolute_difference_u8_reference(x:u8,y:u8)->u8 {if x>=y {return x-y;} return y-x;}

fn absolute_difference_u8_chosen(x:u8,y:u8)->u8 {return max(x,y)-min(x,y);}

fn absolute_difference_u8_rejected(x:u8,y:u8)->u8 {return x-y;}

fn saturating_add_u8_reference(x:u8,y:u8)->u8 {if y>255-x {return 255;} return x+y;}

