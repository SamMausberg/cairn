fn saturating_add_u8_rejected(x:u8,y:u8)->u8 {return add_wrap(x,y);}

fn floor_average_u8_reference(x:u8,y:u8)->u8 {return (x/2)+(y/2)+((x%2+y%2)/2);}

fn floor_average_u8_chosen(x:u8,y:u8)->u8 {return (x&y)+shr(x^y,1);}

fn floor_average_u8_rejected(x:u8,y:u8)->u8 {return add_wrap(x,y)/2;}

fn align_eight_u8_reference(x:u8)->u8 {return (x/8)*8;}

fn align_eight_u8_chosen(x:u8)->u8 {return x & ~u8(7);}

fn align_eight_u8_rejected(x:u8)->u8 {return x/8;}

fn clear_lowest_bit_u8_reference(x:u8)->u8 {if x==0 {return 0;} return x&(x-1);}

fn clear_lowest_bit_u8_chosen(x:u8)->u8 {return x&sub_wrap(x,1);}

fn clear_lowest_bit_u8_rejected(x:u8)->u8 {return x^sub_wrap(x,1);}

