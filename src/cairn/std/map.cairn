// An open-addressed hash table with linear probing and tombstones. The map owns its keys and
// values, so Map[u64, Vec[u8]] is ordinary. A borrow cannot be returned, so a lookup answers
// with a position rather than the value, in one of three forms. `find` gives the raw slot index,
// which the caller reads as m.vals[slot], good until the next insert or remove. `slot` gives a
// Slot that `resolve` checks again later: once its key is removed or the map rehashes, it
// resolves to None, never to another entry. `update` lends the value to a closure, which cannot
// reach the map while it holds it. `get` copies a copyable value out. A map keyed by Vecs is also
// looked up by a view of the elements (`find_view`, `entry_view`), and `sorted` walks the keys in order.
// Cost: expected O(1) per operation; insert reallocates and rehashes past three quarters full,
// so `alloc`, `free` and `zero_init` appear in every caller's row.
//
// ```cairn
// // Counts the words of standard input: printf 'b a b' | cairn run count.cairn prints a 1, then b 2.
// import std.core (Result);
// import std.io as io;
// import std.map (Map);
// import std.text as text;
// import std.vec (Vec);
//
// fn main() -> i32 {
//   let mut input = vec.new[u8]();
//   match io.read_stdin_to_end(input) { Ok(_) => {} Err(_) => return 1; }
//   let mut counts = map.new[Vec[u8], u64]();
//   let mut w = text.cursor();
//   while text.next_word(input, w) {
//     let at = map.entry_view(counts, input.data[w.lo..w.hi], 0);   // copies a word the first time only
//     counts.vals[at] += 1;
//   }
//   let mut order = vec.new[usize]();
//   map.sorted(counts, order);                                        // the live slots, words ascending
//   for s in order { println(counts.keys[s], ' ', counts.vals[s]); }
//   return 0;
// }
// ```
module std.map;
import std.core (Option, Hash, Eq, Ord);
import std.mem;
import std.sort;
import std.vec (Vec);

// state: 0 never used, 1 live, 2 erased. An erased slot still routes probes past it. A live
// slot's stamp is how many keys had been placed when its own key was, so no two entries ever
// share one, across removals and rehashing alike, and a zeroed stamp names nothing.
pub struct Map[K:affine, V:affine] {
  keys:Buf[K];
  vals:Buf[V];
  state:Buf[u8];
  stamps:Buf[u64];
  count:usize;
  fill:usize;
  placed:u64;
}

// A position that remembers which entry it named.
pub struct Slot { at:usize; stamp:u64; }

pub fn new[K:affine, V:affine]() -> Map[K, V] = Map(
  Buf[K](0), Buf[V](0), Buf[u8](0), Buf[u64](0), 0, 0, 0
);
pub fn count[K:affine, V:affine](m:ro<Map[K, V]>) -> usize = m.count;
pub fn slots[K:affine, V:affine](m:ro<Map[K, V]>) -> usize = len(m.state);
pub fn live[K:affine, V:affine](m:ro<Map[K, V]>, slot:usize) -> bool = m.state[slot] == 1;

// The slot holding `key`, else the first slot its probe path may reuse. Capacity is a power of
// two and never full, so the walk always ends.
fn probe[K:Hash + Eq + affine, V:affine](m:ro<Map[K, V]>, key:ro<K>) -> usize {
  let mask = len(m.state) - 1;
  let mut i = usize(hash(key)) & mask;
  let mut free = len(m.state);
  while m.state[i] != 0 {
    if m.state[i] == 1 && same(m.keys[i], key) { return i; }
    if m.state[i] == 2 && free == len(m.state) { free = i; }
    i = (i + 1) & mask;
  }
  if free != len(m.state) { return free; }
  return i;
}

// probe for a key lent as a view of what a Vec key holds, with the Vec's own hash and equality. It is a loop of
// its own because a comparison passed in as a closure would put an indirect call in every lookup's row.
fn probe_view[T:Hash + Eq + copy, V:affine](m:ro<Map[Vec[T], V]>, n:usize, key:ro<T>[n]) -> usize {
  let mask = len(m.state) - 1;
  let mut i = usize(vec.hash_view(key)) & mask;
  let mut free = len(m.state);
  while m.state[i] != 0 {
    if m.state[i] == 1 && mem.equal(m.keys[i], key) { return i; }
    if m.state[i] == 2 && free == len(m.state) { free = i; }
    i = (i + 1) & mask;
  }
  if free != len(m.state) { return free; }
  return i;
}

// Store without considering growth: the caller guarantees a free slot. The answer is where the entry is.
fn place[K:Hash + Eq + affine, V:affine](m:rw<Map[K, V]>, key:K, value:V) -> usize {
  let slot = probe(m, key);
  if m.state[slot] == 1 {
    take(m.vals[slot]); // released here, so the caller sees no old value
  } else {
    if m.state[slot] == 0 { m.fill += 1; }
    m.state[slot] = 1;
    m.keys[slot] = key;
    m.count += 1;
    m.placed += 1;
    m.stamps[slot] = m.placed; // a new entry, even in a slot another key held
  }
  m.vals[slot] = value;
  return slot;
}

// Rehash into fresh storage; `swap` hands the old arrays to locals that release at exit.
fn grow[K:Hash + Eq + affine, V:affine](m:rw<Map[K, V]>) {
  let cap = max(len(m.state) * 2, 8);
  let mut keys = Buf[K](cap);
  let mut vals = Buf[V](cap);
  let mut state = Buf[u8](cap);
  let mut stamps = Buf[u64](cap);
  swap(m.keys, keys);
  swap(m.vals, vals);
  swap(m.state, state);
  swap(m.stamps, stamps); // every entry is placed again below, under a stamp no Slot has seen
  m.count = 0;
  m.fill = 0;
  for i in 0..len(state) {
    if state[i] == 1 { place(m, take(keys[i]), take(vals[i])); }
  }
}

pub fn insert[K:Hash + Eq + affine, V:affine](m:rw<Map[K, V]>, key:K, value:V) {
  put(m, key, value);
}

// insert, answering the slot the entry went to.
fn put[K:Hash + Eq + affine, V:affine](m:rw<Map[K, V]>, key:K, value:V) -> usize {
  if (m.fill + 1) * 4 > len(m.state) * 3 { grow(m); }
  return place(m, key, value);
}

pub fn find[K:Hash + Eq + affine, V:affine](m:ro<Map[K, V]>, key:ro<K>) -> Option[usize] {
  if len(m.state) == 0 { return None; }
  let slot = probe(m, key);
  if m.state[slot] == 1 { return Some(slot); }
  return None;
}

// find for a map keyed by Vecs, by a view of the elements the key holds: a word looks itself up where it
// lies in the input, and no Vec is made for it. Cost: one hash of the view and a comparison per key probed.
pub fn find_view[T:Hash + Eq + copy, V:affine](
  m:ro<Map[Vec[T], V]>, n:usize, key:ro<T>[n]
) -> Option[usize] {
  if len(m.state) == 0 { return None; }
  let slot = probe_view(m, key);
  if m.state[slot] == 1 { return Some(slot); }
  return None;
}

// The slot of `key`'s entry, inserting `key` with `value` first when there is none; a key or value not
// needed is released. `let at = map.entry(m, key, 0); m.vals[at] += 1;` counts. Good until the next insert.
pub fn entry[K:Hash + Eq + affine, V:affine](m:rw<Map[K, V]>, key:K, value:V) -> usize {
  match find(m, key) {
    Some(at) => return at;
    None => {}
  }
  return put(m, key, value);
}

// entry for a map keyed by Vecs, by a view: the key is copied into a Vec of its own only when it is inserted,
// which is the one allocation beside the map's own growth.
pub fn entry_view[T:Hash + Eq + copy, V:affine](
  m:rw<Map[Vec[T], V]>, n:usize, key:ro<T>[n], value:V
) -> usize {
  match find_view(m, key) {
    Some(at) => return at;
    None => {}
  }
  let owned = vec.from(key);
  return put(m, owned, value);
}

// Every live slot appended to `out`, in the order of the keys: the walk a report prints.
// Cost: one pass over the slots and a heapsort of the live ones, O(k log k) comparisons of keys.
pub fn sorted[K:Ord + affine, V:affine](m:ro<Map[K, V]>, out:rw<Vec[usize]>) {
  let first = out.len;
  for slot in 0..len(m.state) { if m.state[slot] == 1 { vec.push(out, slot); } }
  sort.sort_by(out.data[first..out.len], |a:ro<usize>, b:ro<usize>| -> bool {
    return less(m.keys[a], m.keys[b]);
  });
}

// The entry holding `key` as a Slot, which stays checkable across inserts, removes and growth.
pub fn slot[K:Hash + Eq + affine, V:affine](m:ro<Map[K, V]>, key:ro<K>) -> Option[Slot] {
  match find(m, key) {
    Option.Some(at) => { return Option.Some(Slot(at, m.stamps[at])); }
    Option.None => { return Option.None; }
  }
}

// Where the entry `s` named is now: None once its key was removed or the map rehashed, when the
// key has to be looked up again. A stale Slot is never taken for another entry of the map that gave it; against
// another map a Slot is only a number, since every map counts its stamps from zero.
pub fn resolve[K:affine, V:affine](m:ro<Map[K, V]>, s:Slot) -> Option[usize] {
  if s.at >= len(m.state) { return Option.None; }
  if m.state[s.at] != 1 || m.stamps[s.at] != s.stamp { return Option.None; }
  return Option.Some(s.at);
}

// A copy of the value under `key`.
pub fn get[K:Hash + Eq + affine, V:copy](m:ro<Map[K, V]>, key:ro<K>) -> Option[V] {
  match find(m, key) {
    Option.Some(at) => { return Option.Some(m.vals[at]); }
    Option.None => { return Option.None; }
  }
}

// Change the value under `key` in place, or answer false when it is absent. The closure is lent the
// value alone, and the map is lent to this call, so nothing the closure does can move the entry.
pub fn update[K:Hash + Eq + affine, V:affine](
  m:rw<Map[K, V]>, key:ro<K>, change:ro<fn(rw<V>)>
) -> bool {
  match find(m, key) {
    Option.Some(at) => {
      change(m.vals[at]);
      return true;
    }
    Option.None => { return false; }
  }
}

pub fn contains[K:Hash + Eq + affine, V:affine](m:ro<Map[K, V]>, key:ro<K>) -> bool {
  match find(m, key) { Some(_) => return true; None => return false; }
}

pub fn remove[K:Hash + Eq + affine, V:affine](m:rw<Map[K, V]>, key:ro<K>) -> Option[V] {
  match find(m, key) {
    Some(slot) => {
      take(m.keys[slot]);
      m.state[slot] = 2;
      m.count -= 1;
      return Some(take(m.vals[slot]));
    }
    None => return None;
  }
}
