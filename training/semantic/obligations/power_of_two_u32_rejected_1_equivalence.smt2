(set-logic QF_BV)
(declare-const arg_0 (_ BitVec 32))
(define-fun term_0 () Bool (not (= arg_0 (_ bv0 32))))
(define-fun term_1 () (_ BitVec 32) (bvsub arg_0 (_ bv1 32)))
(define-fun term_2 () (_ BitVec 32) (bvand arg_0 term_1))
(define-fun term_3 () Bool (= term_2 (_ bv0 32)))
(define-fun term_4 () Bool (and term_0 term_3))
(define-fun term_5 () Bool term_4)
(define-fun term_6 () Bool term_3)
(assert (not (= term_5 term_6)))
(check-sat)
